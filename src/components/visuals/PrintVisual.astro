---
/** Print: a print set on a table, seen slightly from above. Brochure spread with page edges,
    a foam-board competition panel, and two business cards with card-stock thickness.
    Paper grain and lift/settle shadows come from .obj / .obj-grain in global.css. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.print;
---
<figure class:list={['vz', 'vz-print', 'obj-scene', cls]} data-vz-print role="img" aria-label={v.label}>
  <div class="table obj-table">
    <!-- Brochure spread: two A4 pages, a stack of page edges under the right page -->
    <div class="piece spread obj" data-piece>
      <div class="page page--l obj-grain">
        <span class="kicker">{v.name}</span>
        <span class="book">{v.book}</span>
        <span class="years">{v.years}</span>
      </div>
      <div class="page page--r obj-grain" data-page>
        <span class="plate"></span>
        <span class="lines"><i></i><i></i><i style="width:60%"></i></span>
      </div>
    </div>

    <!-- Competition board on foam board -->
    <div class="piece board obj obj-grain" data-piece>
      <span class="board__title">{v.board}</span>
      <span class="board__sub">{v.boardSub}</span>
      <svg class="plan" viewBox="0 0 100 80" fill="none" aria-hidden="true">
        <path data-plan pathLength="1" d="M8 8h84v64H8z" />
        <path data-plan pathLength="1" d="M8 40h40M48 8v64M48 52h44M70 52v20M28 40v32" />
        <path data-plan pathLength="1" d="M58 20a10 10 0 0 1 20 0" />
      </svg>
      <span class="board__strip"></span>
    </div>

    <!-- Business cards: back and front -->
    <div class="piece bcard bcard--back obj obj-grain" data-piece><span class="mono">A</span></div>
    <div class="piece bcard bcard--front obj obj-grain" data-piece>
      <span class="bcard__name">{v.name}</span>
      <span class="bcard__meta">{v.role}<br />{v.city}</span>
    </div>
  </div>
</figure>

<style>
  .vz { margin: 0; }
  .vz-print {
    padding: clamp(1rem, .8rem + 1vw, 1.5rem);
    background: var(--viz-paper); border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--viz-line);
    overflow: hidden;
  }
  .table { position: relative; aspect-ratio: 4 / 3; container-type: inline-size; }
  .piece { position: absolute; }
  .piece > * { position: relative; z-index: 3; }

  /* Brochure: the spine darkens towards the fold, the right page sits on a stack of page edges */
  .spread { left: 2%; top: 7%; width: 64%; aspect-ratio: 1.414 / 1; display: grid; grid-template-columns: 1fr 1fr; }
  .page { background: #EFE8DC; color: #23211E; padding: 7% 8%; display: grid; }
  .page--l { align-content: space-between; box-shadow: inset -1.8cqw 0 1.6cqw -1.4cqw rgb(0 0 0 / .28); }
  .page--r {
    align-content: start; gap: 8%; background: #F4EFE6;
    box-shadow: inset 1.4cqw 0 1.4cqw -1.2cqw rgb(0 0 0 / .22), .25cqw .2cqw 0 #DCD3C3, .5cqw .4cqw 0 #CFC5B3, .75cqw .6cqw 0 #C2B7A3;
    transform-origin: 0 50%;
  }
  .kicker { font-size: 1.5cqw; letter-spacing: .2em; text-transform: uppercase; opacity: .65; }
  .book { font-family: var(--font-serif); font-size: 5.6cqw; line-height: .95; }
  .years { font-size: 1.5cqw; letter-spacing: .08em; opacity: .65; }
  .plate { display: block; aspect-ratio: 4 / 3; background: #B5603F; }
  .lines { display: grid; gap: .9cqw; }
  .lines i { display: block; height: .6cqw; background: #23211E; opacity: .25; border-radius: 99px; }

  /* Board: A1 portrait on 5 mm foam board (the light edge on the right and bottom) */
  .board {
    right: 3%; top: 2%; width: 29%; aspect-ratio: 1 / 1.414;
    background: #23211E; color: #EFE8DC; padding: 2.4cqw 2.2cqw;
    display: grid; grid-template-rows: auto auto 1fr auto; gap: .8cqw;
    outline: .45cqw solid #E9E3D7; outline-offset: -.45cqw;
    border-right: .5cqw solid #D9D1C2; border-bottom: .5cqw solid #CFC6B5;
  }
  .board__title { font-family: var(--font-serif); font-size: 3.6cqw; line-height: 1; }
  .board__sub { font-size: 1.25cqw; letter-spacing: .06em; opacity: .7; }
  .plan { width: 100%; align-self: center; color: #EFE8DC; }
  .plan path { stroke: currentColor; stroke-width: .8; }
  .board__strip { height: 3cqw; background: #5F6447; }

  /* Business cards: 85 × 55 on thick stock (the darker edge underneath) */
  .bcard { width: 24%; aspect-ratio: 85 / 55; padding: 1.6cqw 1.8cqw; border-radius: .3cqw; }
  .bcard--back {
    left: 38%; bottom: 6%; background: #23211E; color: #EFE8DC;
    display: grid; place-items: center; transform: rotate(7deg);
    border-bottom: .35cqw solid #11100e;
  }
  .mono { font-family: var(--font-serif); font-size: 5cqw; line-height: 1; }
  .bcard--front {
    left: 14%; bottom: 3%; background: #D8C7AE; color: #23211E; transform: rotate(-5deg);
    display: grid; align-content: space-between;
    border-bottom: .35cqw solid #B9A788;
  }
  .bcard__name { font-family: var(--font-serif); font-size: 2.3cqw; }
  .bcard__meta { font-size: 1.15cqw; line-height: 1.4; letter-spacing: .04em; opacity: .75; }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-print]').forEach((root) => {
    if (reduced) return;
    const pieces = root.querySelectorAll<HTMLElement>('[data-piece]');
    const page = root.querySelector<HTMLElement>('[data-page]');
    const plan = root.querySelectorAll<SVGPathElement>('[data-plan]');
    const tl = gsap.timeline({ paused: true });
    // Each piece is set down: held above the table (bigger, wide soft shadow), then it lands
    tl.from(pieces, {
      opacity: 0, y: -34, scale: 1.06, '--lift': 1,
      rotation: (i) => [-6, 5, 14, -12][i] ?? 0,
      duration: 1.2, ease: 'power3.out', stagger: 0.16,
    })
      // The brochure's right page falls open from the spine
      .from(page, { rotationY: -70, transformPerspective: 900, duration: 1.3, ease: 'power3.out' }, 0.25)
      // The floor plan draws on the board once it's down
      .fromTo(plan, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut', stagger: 0.15 }, 0.7);
    tl.progress(0.001).pause();
    ScrollTrigger.create({ trigger: root, start: 'top 70%', once: true, onEnter: () => tl.play() });
  });
</script>
