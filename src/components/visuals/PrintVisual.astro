---
/** Print: a technical drawing that turns into the printed pieces.
    Each sheet is outlined in 1px lines with an architect-style dimension line,
    then "printed": its paper colour wipes down like a print pass and the content appears.
    Flat colour only, no gradients, no fake 3D. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.print;
---
<figure class:list={['vz', 'vz-print', cls]} data-vz-print role="img" aria-label={v.label}>
  <div class="stage">
    <!-- A4 spread (420 × 297) -->
    <div class="sheet spread" data-sheet>
      <span class="dim dim--top" data-dim><i></i><b>420 × 297</b></span>
      <i class="e t"></i><i class="e r"></i><i class="e b"></i><i class="e l"></i>
      <div class="paper" data-paper>
        <div class="pg pg--l">
          <span class="kicker">{v.name}</span>
          <span class="book" data-ink>{v.book}</span>
          <span class="years" data-ink>{v.years}</span>
        </div>
        <div class="pg pg--r">
          <span class="plate" data-ink></span>
          <span class="lines" data-ink><i></i><i></i><i style="width:58%"></i></span>
        </div>
      </div>
    </div>

    <!-- A1 board (594 × 841) -->
    <div class="sheet board" data-sheet>
      <span class="dim dim--top" data-dim><i></i><b>594 × 841</b></span>
      <i class="e t"></i><i class="e r"></i><i class="e b"></i><i class="e l"></i>
      <div class="paper" data-paper>
        <span class="b-title" data-ink>{v.board}</span>
        <span class="b-sub" data-ink>{v.boardSub}</span>
        <svg class="plan" viewBox="0 0 100 80" fill="none" aria-hidden="true">
          <path data-plan pathLength="1" d="M8 8h84v64H8z" />
          <path data-plan pathLength="1" d="M8 40h40M48 8v64M48 52h44M70 52v20M28 40v32" />
          <path data-plan pathLength="1" d="M58 20a10 10 0 0 1 20 0" />
        </svg>
      </div>
    </div>

    <!-- Business card (85 × 55) -->
    <div class="sheet bizcard" data-sheet>
      <span class="dim dim--bottom" data-dim><i></i><b>85 × 55</b></span>
      <i class="e t"></i><i class="e r"></i><i class="e b"></i><i class="e l"></i>
      <div class="paper" data-paper>
        <span class="c-name" data-ink>{v.name}</span>
        <span class="c-meta" data-ink>{v.role} · {v.city}</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .vz { margin: 0; }
  .vz-print { background: #111; border-radius: var(--radius-lg); box-shadow: inset 0 0 0 1px var(--viz-line); overflow: hidden; }
  .stage { position: relative; aspect-ratio: 4 / 3; container-type: inline-size; color: #23211E; }

  .sheet { position: absolute; }
  .spread { left: 7%; top: 16%; width: 52%; aspect-ratio: 420 / 297; }
  .board { left: 66%; top: 10%; width: 25%; aspect-ratio: 594 / 841; }
  .bizcard { left: 22%; top: 70%; width: 21%; aspect-ratio: 85 / 55; }

  /* 1px outline, each edge draws on its own axis */
  .e { position: absolute; background: #4a4a4a; z-index: 2; }
  .e.t, .e.b { left: 0; right: 0; height: 1px; transform-origin: 0 50%; }
  .e.l, .e.r { top: 0; bottom: 0; width: 1px; transform-origin: 50% 0; }
  .e.t { top: 0; } .e.b { bottom: 0; } .e.l { left: 0; } .e.r { right: 0; }

  /* Architect-style dimension line with end ticks */
  .dim { position: absolute; left: 0; right: 0; height: 1px; display: grid; place-items: center; color: #8f8b84; }
  .dim--top { bottom: calc(100% + 2.2cqw); }
  .dim--bottom { top: calc(100% + 2.2cqw); }
  .dim i { position: absolute; inset: 0; background: #3a3a3a; }
  .dim i::before, .dim i::after { content: ''; position: absolute; top: -.6cqw; width: 1px; height: 1.2cqw; background: #3a3a3a; }
  .dim i::before { left: 0; } .dim i::after { right: 0; }
  .dim b { position: relative; padding: 0 .9cqw; background: #111; font-size: 1.05cqw; font-weight: 400; letter-spacing: .08em; font-variant-numeric: tabular-nums; }

  /* The printed paper: flat colour */
  .paper { position: absolute; inset: 0; }
  .spread .paper { display: grid; grid-template-columns: 1fr 1fr; }
  .pg { padding: 7% 8%; display: grid; }
  .pg--l { background: #EFE8DC; align-content: space-between; }
  .pg--r { background: #F4EFE6; align-content: start; gap: 9%; box-shadow: inset 1px 0 0 #d9d0c1; }
  .kicker { font-size: 1.05cqw; letter-spacing: .22em; text-transform: uppercase; opacity: .6; }
  .book { font-family: var(--font-serif); font-size: 4.2cqw; line-height: .98; }
  .years { font-size: 1.05cqw; letter-spacing: .08em; opacity: .6; }
  .plate { display: block; aspect-ratio: 4 / 3; background: #B5603F; }
  .lines { display: grid; gap: .7cqw; }
  .lines i { display: block; height: .45cqw; background: #23211E; opacity: .22; }

  .board .paper { background: #23211E; color: #EFE8DC; padding: 9% 9%; display: grid; grid-template-rows: auto auto 1fr; gap: .6cqw; }
  .b-title { font-family: var(--font-serif); font-size: 2.8cqw; line-height: 1; }
  .b-sub { font-size: .95cqw; letter-spacing: .06em; opacity: .65; }
  .plan { width: 100%; align-self: center; }
  .plan path { stroke: #EFE8DC; stroke-width: .8; }

  .bizcard .paper { background: #D8C7AE; padding: 9% 10%; display: grid; align-content: space-between; }
  .c-name { font-family: var(--font-serif); font-size: 2cqw; }
  .c-meta { font-size: .9cqw; letter-spacing: .06em; opacity: .7; }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-print]').forEach((root) => {
    if (reduced) return;
    const tl = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } });
    root.querySelectorAll<HTMLElement>('[data-sheet]').forEach((sheet, i) => {
      const at = i * 0.35;
      // 1. Outline draws: top & bottom across, left & right down
      tl.from(sheet.querySelectorAll('.e.t, .e.b'), { scaleX: 0, duration: 0.9, ease: 'power3.inOut' }, at)
        .from(sheet.querySelectorAll('.e.l, .e.r'), { scaleY: 0, duration: 0.9, ease: 'power3.inOut' }, at + 0.1)
        // 2. Dimension line extends, then its label
        .from(sheet.querySelector('[data-dim] i'), { scaleX: 0, duration: 0.8, ease: 'power3.inOut' }, at + 0.35)
        .from(sheet.querySelector('[data-dim] b'), { opacity: 0, duration: 0.5 }, at + 0.7)
        // 3. Printed: the paper colour wipes down like a print pass, then the ink appears
        .fromTo(sheet.querySelector('[data-paper]'), { clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)', duration: 1.1, ease: 'expo.inOut' }, at + 1.2)
        .from(sheet.querySelectorAll('[data-ink]'), { opacity: 0, y: 4, duration: 0.7, stagger: 0.06 }, at + 1.9)
        .to(sheet.querySelectorAll('.e'), { opacity: 0, duration: 0.6, ease: 'power1.out' }, at + 2);
    });
    // The floor plan draws on the board once it's printed
    tl.fromTo(root.querySelectorAll('[data-plan]'), { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut', stagger: 0.15 }, 2.6);
    tl.timeScale(1.35); // ~35% quicker overall, same choreography
    tl.progress(0.001).pause();
    ScrollTrigger.create({ trigger: root, start: 'top 72%', once: true, onEnter: () => tl.play() });
  });
</script>
