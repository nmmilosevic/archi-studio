---
/** Hosting & maintenance: uptime counts up, a pulse line draws across, the status light pings once. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.hosting;
---
<figure class:list={['vz', 'vz-host', cls]} data-vz-host role="img" aria-label={v.label}>
  <div class="head">
    <span class="site">aurea-studio.com</span>
    <span class="status"><i data-ping></i>{v.status}</span>
  </div>

  <div class="big">
    <p class="num"><span data-uptime>99.98</span><small>%</small></p>
    <p class="label">{v.uptime}</p>
  </div>

  <svg class="pulse" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 34h120l12-20 16 40 14-34 10 14h228" fill="none" stroke="currentColor" stroke-width="2" pathLength="1" data-pulse />
  </svg>

  <dl class="stats">
    {v.rows.map(([k, val]) => <div><dt>{k}</dt><dd>{val}</dd></div>)}
  </dl>
</figure>

<style>
  .vz { margin: 0; }
  .vz-host {
    display: grid; gap: 1.25rem; padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    background: var(--viz-chrome); border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06);
    color: var(--viz-ink);
  }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; font-size: .8125rem; }
  .site { font-weight: 700; }
  .status {
    display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .75rem;
    border-radius: var(--radius-pill); background: rgb(60 207 142 / .12); color: var(--viz-sage);
  }
  .status i { position: relative; width: .5rem; height: .5rem; border-radius: 50%; background: currentColor; }
  .status i::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: currentColor; opacity: 0; }
  .status.is-pinged i::after { animation: ping 1.2s var(--ease-out) 1; }
  @keyframes ping { from { opacity: .6; transform: scale(1); } to { opacity: 0; transform: scale(3.2); } }

  .num {
    font-family: var(--font-display); font-weight: 600; line-height: .85; letter-spacing: -.04em;
    font-size: clamp(3.5rem, 2.4rem + 3.6vw, 6rem); font-variant-numeric: tabular-nums;
  }
  .num small { font-size: .45em; margin-left: .05em; color: var(--viz-muted); }
  .label { margin-top: .5rem; font-size: .8125rem; color: var(--viz-muted); }
  .pulse { width: 100%; height: 3.5rem; color: var(--viz-sage); }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: .5rem; }
  .stats div { display: grid; gap: .2rem; padding: .75rem .875rem; border-radius: var(--radius-sm); background: var(--viz-chrome-2); }
  .stats dt { font-size: .75rem; color: var(--viz-chrome-text); }
  .stats dd { font-weight: 700; font-size: .875rem; }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-host]').forEach((root) => {
    if (reduced) return;
    const num = root.querySelector<HTMLElement>('[data-uptime]')!;
    const pulse = root.querySelector<SVGPathElement>('[data-pulse]')!;
    const status = root.querySelector<HTMLElement>('.status')!;
    const n = { v: 90 };
    const tl = gsap.timeline({ paused: true });
    tl.fromTo(n, { v: 90 }, { v: 99.98, duration: 1.6, ease: 'expo.out', onUpdate: () => { num.textContent = n.v.toFixed(2); } })
      .fromTo(pulse, { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut' }, 0.2)
      .from(root.querySelectorAll('.stats > div'), { opacity: 0, y: 10, duration: 0.6, ease: 'power2.out', stagger: 0.07 }, 0.6)
      .call(() => status.classList.add('is-pinged'), [], 1.5);
    tl.progress(0.001).pause();
    num.textContent = '90.00';
    ScrollTrigger.create({ trigger: root, start: 'top 75%', once: true, onEnter: () => tl.play() });
  });
</script>
