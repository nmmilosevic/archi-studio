---
/** Search visibility: the query types itself, then the studio climbs from #5 to #1. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.search;
---
<figure class:list={['vz', 'vz-search', cls]} data-vz-search role="img" aria-label={v.label}>
  <div class="q">
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.4" /><path d="m10.5 10.5 3.5 3.5" stroke="currentColor" stroke-width="1.4" /></svg>
    <span class="q__text" data-typed>{v.query}</span>
  </div>

  <div class="board">
    <p class="rank"><span class="rank__hash">#</span><span data-rank>1</span></p>
    <ol class="list">
      <li class="row row--studio" data-row>
        <span class="row__url">{v.url}</span>
        <span class="row__title">{v.title}</span>
      </li>
      {[0, 1, 2, 3].map(() => <li class="row" data-row><i style="width:38%"></i><i class="t" style="width:72%"></i></li>)}
    </ol>
  </div>
</figure>

<style>
  .vz { margin: 0; }
  .vz-search {
    display: grid; gap: 1.25rem; padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    background: var(--viz-paper); border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--viz-line);
    color: var(--viz-ink);
  }
  .q {
    display: flex; align-items: center; gap: .75rem;
    padding: .875rem 1.125rem; border-radius: var(--radius-pill);
    background: var(--viz-panel); box-shadow: inset 0 0 0 1px var(--viz-line);
    font-size: 1rem;
  }
  .q svg { width: 1rem; color: var(--viz-muted); flex: none; }
  .q__text { white-space: nowrap; }

  .board { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: start; }
  .rank {
    font-family: var(--font-display); font-weight: 600; line-height: .8;
    font-size: clamp(4.5rem, 3rem + 5vw, 8rem); letter-spacing: -.04em;
    color: var(--viz-clay); min-width: 1.6em; font-variant-numeric: tabular-nums;
  }
  .rank__hash { font-size: .45em; vertical-align: top; margin-right: .05em; color: var(--viz-muted); }
  .list { display: grid; gap: .5rem; }
  .row {
    display: grid; gap: .35rem; padding: .75rem .9rem;
    border-radius: var(--radius-sm); background: var(--viz-panel);
  }
  .row i { display: block; height: .4rem; border-radius: 99px; background: var(--viz-line); }
  .row i.t { height: .55rem; }
  .row--studio { background: var(--viz-clay); color: #0a0a0a; position: relative; z-index: 1; }
  .row__url { font-size: .75rem; opacity: .7; }
  .row__title { font-weight: 700; font-size: .9375rem; letter-spacing: -.01em; }
  @media (max-width: 599px) { .board { grid-template-columns: 1fr; } .rank { font-size: 4rem; } }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-search]').forEach((root) => {
    if (reduced) return;
    const typed = root.querySelector<HTMLElement>('[data-typed]')!;
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
    const rank = root.querySelector<HTMLElement>('[data-rank]')!;
    const chars = typed.textContent!.length;
    const step = () => rows[1].offsetTop - rows[0].offsetTop;
    const n = { v: 5 };

    const tl = gsap.timeline({ paused: true });
    tl.fromTo(typed, { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: chars * 0.045, ease: `steps(${chars})` })
      // the studio starts last; the others start one row higher
      .fromTo(rows[0], { y: () => step() * 4 }, { y: 0, duration: 1.3, ease: 'expo.inOut' }, '+=0.25')
      .fromTo(rows.slice(1), { y: () => -step() }, { y: 0, duration: 1.3, ease: 'expo.inOut' }, '<')
      .fromTo(n, { v: 5 }, { v: 1, duration: 1.3, ease: 'expo.inOut', onUpdate: () => { rank.textContent = String(Math.round(n.v)); } }, '<');
    tl.progress(0.001).pause(); // show the start state until it scrolls into view
    rank.textContent = '5';
    ScrollTrigger.create({ trigger: root, start: 'top 75%', once: true, onEnter: () => tl.play() });
  });
</script>
