---
/** Search visibility: a search result where the studio ranks first, plus score rings. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const t = useContent(lang).services.visuals;
const v = t.search;
const scores = [98, 100, 100];
const C = 2 * Math.PI * 18; // ring circumference
---
<figure class:list={['viz', 'viz-search', cls]} data-viz-search>
  <div class="viz__frame" role="img" aria-label={v.label}>
    <div class="bar">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.25" /><path d="m10.5 10.5 3.5 3.5" stroke="currentColor" stroke-width="1.25" /></svg>
      <span>{v.query}</span>
    </div>

    <ol class="results">
      <li class="hit hit--studio" data-hit>
        <span class="viz__muted">{v.url}</span>
        <span class="hit__title">{v.title}</span>
        <span class="viz__muted">{v.desc}</span>
      </li>
      <li class="hit" data-hit><span class="ph" style="width:34%"></span><span class="ph ph--title" style="width:62%"></span><span class="ph" style="width:88%"></span></li>
      <li class="hit" data-hit><span class="ph" style="width:28%"></span><span class="ph ph--title" style="width:54%"></span><span class="ph" style="width:80%"></span></li>
    </ol>

    <div class="scores">
      {scores.map((s, i) => (
        <div class="score">
          <svg viewBox="0 0 44 44" aria-hidden="true">
            <circle class="ring ring--track" cx="22" cy="22" r="18" />
            <circle class="ring ring--value" cx="22" cy="22" r="18" stroke-dasharray={C} stroke-dashoffset={C * (1 - s / 100)} data-ring={C * (1 - s / 100)} data-c={C} />
          </svg>
          <span class="score__num">{s}</span>
          <span class="viz__label">{v.scores[i]}</span>
        </div>
      ))}
    </div>
  </div>
</figure>

<style>
  .bar {
    display: flex; align-items: center; gap: .625rem;
    padding: .75rem 1rem; margin-bottom: 1.25rem;
    background: var(--viz-paper); font-size: .9375rem;
    box-shadow: 0 0 0 1px var(--viz-line);
  }
  .bar svg { width: 1rem; color: var(--viz-muted); }
  .results { display: grid; gap: .75rem; }
  .hit { display: grid; gap: .3rem; padding: .875rem 1rem; background: var(--viz-paper); position: relative; box-shadow: 0 0 0 1px var(--viz-line); }
  .hit--studio { box-shadow: inset 2px 0 0 var(--viz-clay), 0 0 0 1px var(--viz-line), 0 16px 32px -18px rgb(0 0 0 / .7); z-index: 1; }
  .hit__title { font-size: 1.0625rem; font-weight: var(--fw-medium); letter-spacing: -.01em; color: var(--viz-clay); }
  .ph { display: block; height: .5rem; background: var(--viz-line); opacity: .7; }
  .ph--title { height: .75rem; background: var(--viz-line); }

  .scores { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .score { position: relative; display: grid; justify-items: start; gap: .375rem; }
  .score svg { width: 3.25rem; height: 3.25rem; transform: rotate(-90deg); }
  .ring { fill: none; stroke-width: 3; }
  .ring--track { stroke: var(--viz-line); }
  .ring--value { stroke: var(--viz-sage); }
  .score__num {
    position: absolute; top: 0; left: 0; width: 3.25rem; height: 3.25rem;
    display: grid; place-items: center;
    font-size: .875rem; font-weight: var(--fw-medium);
  }
</style>
