---
/** Portfolio systems: wireframe project cards sort themselves into a clean, filterable grid. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const t = useContent(lang);
const v = t.services.visuals.portfolio;
const types = t.home.studios.labels; // Architecture / Interiors / Landscape, translated
const cards = [
  { name: 'Villa Aurora', place: 'Benahavís', type: 0 },
  { name: 'Casa Lunara', place: 'Marbella', type: 1 },
  { name: 'Casa Bruta', place: 'Málaga', type: 0 },
  { name: 'Jardín Verde', place: 'Estepona', type: 2 },
  { name: 'Casa Alba', place: 'Sotogrande', type: 1 },
  { name: 'Patio Norte', place: 'Ronda', type: 2 },
];
---
<figure class:list={['vz', 'vz-grid', cls]} data-vz-grid role="img" aria-label={v.label}>
  <div class="filters" data-cap>
    {types.map((label, i) => <span class:list={['chip', { 'is-on': i === 0 }]}>{label}</span>)}
  </div>
  <ul class="pcards">
    {cards.map((c) => (
      <li class="pcard" data-card>
        <span class="pcard__img" aria-hidden="true">
          <svg viewBox="0 0 48 36" fill="none"><path d="M4 30 17 17l9 8 6-5 12 10" stroke="currentColor" stroke-width="1.5" /><circle cx="33" cy="10" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
        </span>
        <span class="pcard__cap" data-cap>
          <b>{c.name}</b>
          <span class="pcard__meta"><span>{c.place}</span><span class="tag">{types[c.type]}</span></span>
        </span>
      </li>
    ))}
  </ul>
</figure>

<style>
  .vz { margin: 0; }
  .vz-grid {
    display: grid; gap: 1rem;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    background: var(--viz-paper); border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--viz-line);
    color: var(--viz-ink);
  }
  .filters { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip {
    padding: .35rem .8rem; border-radius: var(--radius-pill); font-size: .75rem; font-weight: 500;
    color: var(--viz-muted); box-shadow: inset 0 0 0 1px var(--viz-line);
  }
  .chip.is-on { background: var(--viz-clay); color: #0a0a0a; box-shadow: none; }
  .pcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .pcard {
    display: grid; gap: .6rem; padding: .5rem; border-radius: var(--radius-sm);
    background: var(--viz-panel); box-shadow: inset 0 0 0 1px var(--viz-line), 0 18px 30px -22px rgb(0 0 0 / .8);
    will-change: transform;
  }
  .pcard__img {
    display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: calc(var(--radius-sm) - 4px);
    background: var(--viz-paper); box-shadow: inset 0 0 0 1px var(--viz-line); color: var(--viz-line);
  }
  .pcard__img svg { width: 38%; color: #4a4741; }
  .pcard__cap { display: grid; gap: .3rem; padding: 0 .25rem .25rem; font-size: .75rem; line-height: 1.3; }
  .pcard__cap b { font-weight: 700; font-size: .8125rem; }
  .pcard__meta { display: flex; justify-content: space-between; align-items: center; gap: .4rem; flex-wrap: wrap; color: var(--viz-muted); }
  .tag { padding: .1rem .45rem; border-radius: var(--radius-pill); font-size: .625rem; box-shadow: inset 0 0 0 1px var(--viz-line); }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-grid]').forEach((root) => {
    if (reduced) return;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const caps = root.querySelectorAll('[data-cap]');
    // Offsets that pull every card into one loose pile in the middle
    const pile = (el: HTMLElement, i: number) => {
      const r = root.getBoundingClientRect(), b = el.getBoundingClientRect();
      return {
        x: r.left + r.width / 2 - (b.left + b.width / 2) + (i - 2.5) * 6,
        y: r.top + r.height / 2 - (b.top + b.height / 2) + (i % 2 ? 8 : -6),
        rotation: [-9, 6, -3, 11, -6, 4][i],
      };
    };
    const tl = gsap.timeline({ paused: true });
    tl.from(cards, {
      x: (i, el) => pile(el, i).x, y: (i, el) => pile(el, i).y, rotation: (i, el) => pile(el, i).rotation,
      duration: 1.3, ease: 'expo.inOut', stagger: { each: 0.06, from: 'center' },
    }).from(caps, { opacity: 0, y: 6, duration: 0.5, ease: 'power2.out', stagger: 0.05 }, '-=0.4');
    tl.progress(0.001).pause();
    ScrollTrigger.create({ trigger: root, start: 'top 75%', once: true, onEnter: () => tl.play() });
  });
</script>
