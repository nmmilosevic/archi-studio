---
/** Portfolio systems: a messy pile of project cards sorts itself into a clean grid. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.portfolio;
const cards = [
  { name: 'Villa Aurora', place: 'Benahavís', tone: 'stone' },
  { name: 'Casa Lunara', place: 'Marbella', tone: 'clay' },
  { name: 'Casa Bruta', place: 'Málaga', tone: 'dark' },
  { name: 'Jardín Verde', place: 'Estepona', tone: 'sage' },
  { name: 'Casa Alba', place: 'Sotogrande', tone: 'clay' },
  { name: 'Patio Norte', place: 'Ronda', tone: 'stone' },
];
---
<figure class:list={['vz', 'vz-grid', cls]} data-vz-grid role="img" aria-label={v.label}>
  <ul class="cards">
    {cards.map((c) => (
      <li class="card" data-card>
        <i class:list={['img', `img--${c.tone}`]}></i>
        <span class="cap" data-cap><b>{c.name}</b><span>{c.place}</span></span>
      </li>
    ))}
  </ul>
</figure>

<style>
  .vz { margin: 0; }
  .vz-grid {
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    background: var(--viz-paper); border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--viz-line);
    color: var(--viz-ink);
  }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .card { display: grid; gap: .5rem; will-change: transform; }
  .img { display: block; aspect-ratio: 4 / 5; border-radius: var(--radius-sm); box-shadow: 0 18px 30px -20px rgb(0 0 0 / .8); }
  .img--stone { background: var(--viz-tone-stone); }
  .img--clay { background: var(--viz-tone-clay); }
  .img--sage { background: var(--viz-tone-sage); }
  .img--dark { background: linear-gradient(160deg, #4a4642 0%, #2a2826 60%, #1a1918 100%); }
  .cap { display: grid; gap: .1rem; font-size: .75rem; line-height: 1.3; }
  .cap b { font-weight: 700; font-size: .8125rem; }
  .cap span { color: var(--viz-muted); }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-grid]').forEach((root) => {
    if (reduced) return;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const caps = root.querySelectorAll('[data-cap]');
    // Offsets that pull every card into one loose pile in the middle
    const pile = (el: HTMLElement, i: number) => {
      const r = root.getBoundingClientRect(), b = el.getBoundingClientRect();
      return {
        x: r.left + r.width / 2 - (b.left + b.width / 2) + (i - 2.5) * 6,
        y: r.top + r.height / 2 - (b.top + b.height / 2) + (i % 2 ? 8 : -6),
        rotation: [-9, 6, -3, 11, -6, 4][i],
      };
    };
    const tl = gsap.timeline({ paused: true });
    tl.from(cards, {
      x: (i, el) => pile(el, i).x, y: (i, el) => pile(el, i).y, rotation: (i, el) => pile(el, i).rotation,
      duration: 1.3, ease: 'expo.inOut', stagger: { each: 0.06, from: 'center' },
    }).from(caps, { opacity: 0, y: 6, duration: 0.5, ease: 'power2.out', stagger: 0.05 }, '-=0.4');
    tl.progress(0.001).pause();
    ScrollTrigger.create({ trigger: root, start: 'top 75%', once: true, onEnter: () => tl.play() });
  });
</script>
