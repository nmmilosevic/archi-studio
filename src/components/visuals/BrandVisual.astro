---
/** Brand: an identity being constructed.
    Left: construction lines draw (square, thirds, circle), the wordmark rises letter by letter.
    Right: a type scale slides in row by row, then the palette grows as solid swatches.
    1px lines, flat colour, no gradients. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.brand;
const palette = ['#EFE8DC', '#D8C7AE', '#B5603F', '#5F6447', '#23211E'];
const letters = 'AUREA'.split('');
---
<figure class:list={['vz', 'vz-brand', cls]} data-vz-brand role="img" aria-label={v.label}>
  <div class="stage">
    <!-- Construction field -->
    <div class="field">
      <i class="ln h" style="top:0" data-h></i><i class="ln h" style="top:33.333%" data-h></i><i class="ln h" style="top:66.666%" data-h></i><i class="ln h" style="top:100%" data-h></i>
      <i class="ln v" style="left:0" data-v></i><i class="ln v" style="left:33.333%" data-v></i><i class="ln v" style="left:66.666%" data-v></i><i class="ln v" style="left:100%" data-v></i>
      <svg class="circle" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="49.5" pathLength="1" data-circle /></svg>
      <div class="mark">
        <span class="word">{letters.map((l) => <span class="lt"><span data-letter>{l}</span></span>)}</span>
        <span class="sub" data-sub>Studio · {v.sample}</span>
      </div>
    </div>

    <!-- Type scale + palette -->
    <div class="side">
      <ul class="scale">
        <li data-row><span class="lbl">{v.scale[0]}</span><span class="s-display">Aa</span></li>
        <li data-row><span class="lbl">{v.scale[1]}</span><span class="s-heading">{v.sample}</span></li>
        <li data-row><span class="lbl">{v.scale[2]}</span><span class="s-body">{v.body}</span></li>
      </ul>
      <ul class="swatches">
        {palette.map((c, i) => (
          <li data-swatch style={`--c:${c}`}><span class="chip"></span><span class="name">{v.colors[i]}</span></li>
        ))}
      </ul>
    </div>
  </div>
</figure>

<style>
  .vz { margin: 0; }
  .vz-brand { background: #111; border-radius: var(--radius-lg); box-shadow: inset 0 0 0 1px var(--viz-line); overflow: hidden; }
  .stage {
    position: relative; aspect-ratio: 4 / 3; container-type: inline-size;
    display: grid; grid-template-columns: 1fr 1fr; gap: 6cqw; align-items: center; padding: 7cqw 6cqw;
    color: #f4f1ea;
  }

  /* Construction field: a square with thirds and an inscribed circle */
  .field { position: relative; aspect-ratio: 1; }
  .ln { position: absolute; background: #2f2f2f; }
  .ln.h { left: 0; right: 0; height: 1px; transform-origin: 0 50%; }
  .ln.v { top: 0; bottom: 0; width: 1px; transform-origin: 50% 0; }
  .circle { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .circle circle { fill: none; stroke: #3a3a3a; stroke-width: .3; }
  .mark { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.6cqw; }
  .word { display: flex; font-family: var(--font-serif); font-size: 6.6cqw; letter-spacing: .18em; padding-left: .18em; line-height: 1; }
  .lt { display: inline-block; overflow: hidden; }
  .lt > span { display: inline-block; }
  .sub { font-size: 1.1cqw; letter-spacing: .3em; text-transform: uppercase; color: #8f8b84; }

  /* Type scale */
  .side { display: grid; gap: 4cqw; align-content: center; }
  .scale li { display: grid; grid-template-columns: 9cqw 1fr; align-items: baseline; gap: 1.5cqw; padding-block: 1.4cqw; border-top: 1px solid #2a2a2a; overflow: hidden; }
  .scale li:last-child { border-bottom: 1px solid #2a2a2a; }
  .lbl { font-size: 1cqw; letter-spacing: .12em; text-transform: uppercase; color: #8f8b84; }
  .s-display { font-family: var(--font-serif); font-size: 6cqw; line-height: .9; }
  .s-heading { font-family: var(--font-display); font-size: 2.4cqw; letter-spacing: -.02em; }
  .s-body { font-size: 1.2cqw; line-height: 1.4; color: #cfcac1; }

  /* Palette: five flat swatches */
  .swatches { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1cqw; }
  .swatches li { display: grid; gap: .8cqw; }
  .chip { display: block; aspect-ratio: 1 / 1.3; background: var(--c); transform-origin: 50% 100%; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06); }
  .name { font-size: .95cqw; color: #8f8b84; }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-brand]').forEach((root) => {
    if (reduced) return;
    const tl = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } });
    // Construction lines draw, then the circle
    tl.from(root.querySelectorAll('[data-h]'), { scaleX: 0, duration: 1, ease: 'power3.inOut', stagger: 0.08 }, 0)
      .from(root.querySelectorAll('[data-v]'), { scaleY: 0, duration: 1, ease: 'power3.inOut', stagger: 0.08 }, 0.1)
      .fromTo(root.querySelector('[data-circle]'), { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut' }, 0.35)
      // Wordmark rises letter by letter, letter-spacing settles
      .from(root.querySelectorAll('[data-letter]'), { yPercent: 115, duration: 1.1, stagger: 0.07 }, 0.9)
      .from(root.querySelector('.word'), { letterSpacing: '.5em', duration: 1.8, ease: 'expo.out' }, 0.9)
      .from(root.querySelector('[data-sub]'), { opacity: 0, y: 6, duration: 0.8 }, 1.5)
      // Type scale rows slide in
      .from(root.querySelectorAll('[data-row] > *'), { yPercent: 100, opacity: 0, duration: 0.9, stagger: 0.07 }, 1.1)
      // Palette swatches grow up from their baseline
      .from(root.querySelectorAll('[data-swatch] .chip'), { scaleY: 0, duration: 1, ease: 'expo.inOut', stagger: 0.08 }, 1.6)
      .from(root.querySelectorAll('[data-swatch] .name'), { opacity: 0, duration: 0.6, stagger: 0.08 }, 2.1);
    tl.timeScale(1.35); // ~35% quicker overall, same choreography
    tl.progress(0.001).pause();
    ScrollTrigger.create({ trigger: root, start: 'top 72%', once: true, onEnter: () => tl.play() });
  });
</script>
