---
/** Brand refinement: a small brand board. Wordmark, type, print, palette. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.brand;
const palette = [
  { hex: '#EFE8DC', ink: '#23211E' },
  { hex: '#D8C7AE', ink: '#23211E' },
  { hex: '#B5603F', ink: '#FBF6EE' },
  { hex: '#5F6447', ink: '#FBF6EE' },
  { hex: '#23211E', ink: '#EFE8DC' },
];
---
<figure class:list={['vz', 'vz-brand', cls]} data-vz-brand role="img" aria-label={v.label}>
  <div class="board">
    <div class="tile tile--word" data-tile>
      <span class="word" data-word>Aurea</span>
      <span class="word-sub">Studio · {v.sample}</span>
    </div>
    <div class="tile tile--type" data-tile>
      <span class="aa">Aa</span>
      <span class="fonts"><b>Instrument Serif</b><span>Satoshi</span></span>
    </div>
    <div class="tile tile--card" data-tile>
      <span class="card-name">Aurea Studio</span>
      <span class="card-meta">{v.sample}<br />Marbella</span>
    </div>
    <ul class="tile tile--palette" data-tile>
      {palette.map((c, i) => (
        <li style={`background:${c.hex};color:${c.ink}`} data-strip>
          <span>{v.colors[i]}</span><span class="hex">{c.hex}</span>
        </li>
      ))}
    </ul>
  </div>
</figure>

<style>
  .vz { margin: 0; }
  .vz-brand {
    padding: clamp(1rem, .8rem + 1vw, 1.5rem);
    background: var(--viz-paper); border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--viz-line);
  }
  .board {
    display: grid; gap: .625rem;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "word word" "type pal" "card pal";
  }
  .tile { border-radius: var(--radius-sm); overflow: hidden; }

  .tile--word {
    grid-area: word; display: grid; place-items: center; align-content: center; gap: .5rem;
    padding: clamp(1.75rem, 1rem + 3vw, 3rem) 1rem;
    background: #EFE8DC; color: #23211E;
  }
  .word { font-family: var(--font-serif); font-size: clamp(3rem, 1.8rem + 4vw, 5.5rem); line-height: .9; letter-spacing: .14em; padding-left: .14em; text-transform: uppercase; }
  .word-sub { font-size: .6875rem; letter-spacing: .28em; text-transform: uppercase; opacity: .7; }

  .tile--type {
    grid-area: type; display: grid; align-content: space-between; gap: 1rem;
    padding: 1rem; min-height: 9rem;
    background: #23211E; color: #EFE8DC;
  }
  .aa { font-family: var(--font-serif); font-size: clamp(3rem, 2rem + 2.6vw, 4.5rem); line-height: .85; }
  .fonts { display: grid; font-size: .75rem; line-height: 1.4; }
  .fonts span { opacity: .65; }

  .tile--card {
    grid-area: card; display: grid; align-content: space-between; gap: 1rem;
    padding: 1rem; min-height: 7rem;
    background: #D8C7AE; color: #23211E;
  }
  .card-name { font-family: var(--font-serif); font-size: 1.25rem; letter-spacing: .02em; }
  .card-meta { font-size: .6875rem; line-height: 1.45; letter-spacing: .04em; opacity: .75; }

  .tile--palette { grid-area: pal; display: grid; grid-template-rows: repeat(5, 1fr); }
  .tile--palette li {
    display: flex; justify-content: space-between; align-items: flex-end; gap: .5rem;
    padding: .6rem .75rem; font-size: .75rem; font-weight: 500; transform-origin: 0 50%;
  }
  .tile--palette .hex { font-variant-numeric: tabular-nums; opacity: .7; font-weight: 400; }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-brand]').forEach((root) => {
    if (reduced) return;
    const tl = gsap.timeline({ paused: true });
    tl.from(root.querySelectorAll('[data-tile]'), { opacity: 0, scale: 0.96, duration: 0.8, ease: 'expo.out', stagger: 0.1 })
      .from(root.querySelector('[data-word]'), { letterSpacing: '-0.04em', duration: 1.4, ease: 'expo.inOut' }, 0.2)
      .from(root.querySelectorAll('[data-strip]'), { scaleX: 0, duration: 0.9, ease: 'expo.out', stagger: 0.07 }, 0.45);
    tl.progress(0.001).pause();
    ScrollTrigger.create({ trigger: root, start: 'top 75%', once: true, onEnter: () => tl.play() });
  });
</script>
