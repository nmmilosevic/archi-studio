---
/** Web: a page assembles itself.
    1) the browser frame draws in 1px lines, 2) the layout appears as a 1px wireframe,
    3) blocks fill with solid colour and real content, 4) a cursor glides to the button and clicks.
    Flat colour only, no gradients, no fake 3D. */
import { useContent, type Lang } from '../../i18n';

interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const v = useContent(lang).services.visuals.web;
const words = v.headline.split(' ');
const tones = ['#B5603F', '#5F6447', '#D8C7AE'];
---
<figure class:list={['vz', 'vz-web', cls]} data-vz-web role="img" aria-label={v.label}>
  <div class="stage">
    <div class="frame" data-frame>
      <i class="edge edge--t" data-edge-h></i><i class="edge edge--r" data-edge-v></i><i class="edge edge--b" data-edge-h></i><i class="edge edge--l" data-edge-v></i>
      <div class="bar" data-bar>
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="url">{v.url}</span>
      </div>

      <div class="page" data-page>
        <div class="nav block" data-block>
          <span class="logo" data-fill>AUREA</span>
          <span class="links" data-fill>{v.nav.map((n) => <span>{n}</span>)}</span>
        </div>

        <div class="hero">
          <div class="copy block" data-block data-copy>
            <span class="h1">{words.map((w) => <span class="w"><span data-word>{w}</span></span>)}</span>
            <span class="cta" data-cta data-fill>{v.cta}</span>
          </div>
          <div class="picture block" data-block data-paint="#D8C7AE">
            <svg viewBox="0 0 160 110" fill="none" aria-hidden="true">
              <path data-draw pathLength="1" d="M4 92h152" />
              <path data-draw pathLength="1" d="M30 92V60h70v32M64 60V44h66v16h-30" />
              <path data-draw pathLength="1" d="M80 44v16M96 44v16M112 44v16M40 92V74h14v18" />
              <path data-draw pathLength="1" d="M18 92V76M18 56a10 10 0 1 1 0 20a10 10 0 1 1 0-20z" />
              <path data-draw pathLength="1" d="M134 24a6 6 0 1 1 0 12a6 6 0 1 1 0-12z" />
            </svg>
          </div>
        </div>

        <ul class="pcards">
          {v.projects.map((p, i) => (
            <li class="pcard block" data-block data-paint={tones[i]}>
              <span class="cap" data-fill style={i === 2 ? 'color:#23211E' : undefined}>{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <svg class="cursor" viewBox="0 0 16 16" aria-hidden="true" data-cursor><path d="M2 1l11 7-5 1.2L5.6 14z" fill="#f4f1ea" stroke="#0a0a0a" stroke-width="1" /></svg>
    </div>
  </div>
</figure>

<style>
  .vz { margin: 0; }
  .vz-web { background: #111; border-radius: var(--radius-lg); box-shadow: inset 0 0 0 1px var(--viz-line); overflow: hidden; }
  .stage { position: relative; aspect-ratio: 4 / 3; container-type: inline-size; padding: 7cqw 6cqw; }

  .frame { position: relative; height: 100%; display: grid; grid-template-rows: auto 1fr; }
  .edge { position: absolute; background: #3a3a3a; }
  .edge--t { top: 0; left: 0; right: 0; height: 1px; transform-origin: 0 50%; }
  .edge--r { top: 0; bottom: 0; right: 0; width: 1px; transform-origin: 50% 0; }
  .edge--b { bottom: 0; left: 0; right: 0; height: 1px; transform-origin: 100% 50%; }
  .edge--l { top: 0; bottom: 0; left: 0; width: 1px; transform-origin: 50% 100%; }

  .bar { display: flex; align-items: center; gap: 2cqw; padding: 1.4cqw 1.8cqw; border-bottom: 1px solid #2a2a2a; }
  .dots { display: flex; gap: .7cqw; }
  .dots i { width: 1cqw; height: 1cqw; border-radius: 50%; border: 1px solid #4a4a4a; }
  .url { flex: 1; text-align: center; font-size: 1.15cqw; color: #8f8b84; letter-spacing: .02em; margin-right: 4cqw; }

  .page { position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 1.8cqw; padding: 2cqw; min-height: 0; color: #f4f1ea; }
  /* every block starts as a 1px wireframe box, then gets painted */
  .block { position: relative; box-shadow: inset 0 0 0 1px #3a3a3a; transition: box-shadow .5s; }
  .block.is-painted { box-shadow: inset 0 0 0 1px transparent; }

  .nav { display: flex; justify-content: space-between; align-items: center; padding: 1cqw 1.2cqw; }
  .logo { font-family: var(--font-serif); font-size: 1.9cqw; letter-spacing: .3em; }
  .links { display: flex; gap: 2.2cqw; font-size: 1.05cqw; letter-spacing: .1em; text-transform: uppercase; color: #8f8b84; }

  .hero { display: grid; grid-template-columns: 1fr 1.15fr; gap: 1.8cqw; min-height: 0; }
  .copy { display: grid; align-content: center; justify-items: start; gap: 2.4cqw; padding: 1.6cqw; }
  .h1 { font-family: var(--font-serif); font-size: 3.9cqw; line-height: 1.04; display: flex; flex-wrap: wrap; column-gap: .25em; }
  .w { display: inline-block; overflow: hidden; padding-bottom: .08em; }
  .w > span { display: inline-block; }
  .cta { font-size: 1.1cqw; padding: .9cqw 1.8cqw; border-radius: 99px; border: 1px solid #f4f1ea; transition: background-color .35s, color .35s, border-color .35s; }
  .cta.is-on { background: var(--accent); border-color: var(--accent); color: #0a0a0a; }
  .picture { display: grid; place-items: center; }
  .picture svg { width: 82%; color: #23211E; }
  .picture path { stroke: currentColor; stroke-width: .8; stroke-linecap: round; stroke-linejoin: round; }

  .pcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.8cqw; }
  .pcard { aspect-ratio: 16 / 7; display: flex; align-items: flex-end; padding: 1cqw 1.2cqw; }
  .cap { font-size: 1.05cqw; color: #f4f1ea; }

  .cursor { position: absolute; width: 2.6cqw; left: 92%; top: 96%; z-index: 3; pointer-events: none; }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-vz-web]').forEach((root) => {
    const blocks = Array.from(root.querySelectorAll<HTMLElement>('[data-block]'));
    const paintAll = () => blocks.forEach((b) => { if (b.dataset.paint) b.style.backgroundColor = b.dataset.paint; b.classList.add('is-painted'); });
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const cta = root.querySelector<HTMLElement>('[data-cta]')!;
    const cursor = root.querySelector<SVGElement>('[data-cursor]')!;
    if (reduced) { paintAll(); cta.classList.add('is-on'); cursor.style.display = 'none'; return; }

    // Where the cursor should land: the middle of the button, in % of the frame
    const target = () => {
      const f = frame.getBoundingClientRect(), c = cta.getBoundingClientRect();
      return { left: `${((c.left + c.width * 0.55) - f.left) / f.width * 100}%`, top: `${((c.top + c.height * 0.5) - f.top) / f.height * 100}%` };
    };

    const tl = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } });
    // 1. Frame draws, edge by edge, then the browser bar
    tl.from(root.querySelectorAll('[data-edge-h]'), { scaleX: 0, duration: 0.8, ease: 'power3.inOut', stagger: 0.24 }, 0)
      .from(root.querySelectorAll('[data-edge-v]'), { scaleY: 0, duration: 0.8, ease: 'power3.inOut', stagger: 0.24 }, 0.12)
      .from(root.querySelector('[data-bar]'), { opacity: 0, duration: 0.6 }, 0.6)
      // 2. The layout appears as wireframe boxes
      .from(blocks, { opacity: 0, scale: 0.97, duration: 0.8, stagger: 0.08 }, 0.8)
      // 3. Blocks are painted, content arrives
      .to(blocks, {
        backgroundColor: (_i: number, el: HTMLElement) => el.dataset.paint || 'rgba(0,0,0,0)',
        duration: 0.7, ease: 'power2.out', stagger: 0.08,
        onComplete: () => blocks.forEach((b) => b.classList.add('is-painted')),
      }, 1.55)
      .from(root.querySelectorAll('[data-fill]'), { opacity: 0, duration: 0.6, stagger: 0.05 }, 1.7)
      .from(root.querySelectorAll('[data-word]'), { yPercent: 110, duration: 1, stagger: 0.06 }, 1.7)
      .fromTo(root.querySelectorAll('[data-draw]'), { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 1.3, ease: 'power2.inOut', stagger: 0.1 }, 1.85)
      // 4. Cursor glides to the button and clicks it
      .from(cursor, { opacity: 0, duration: 0.3, ease: 'power1.out' }, 2.6)
      .to(cursor, { left: () => target().left, top: () => target().top, duration: 1.2, ease: 'power3.inOut' }, 2.6)
      .to(cta, { scale: 0.93, duration: 0.12, ease: 'power2.out', onComplete: () => cta.classList.add('is-on') }, 3.8)
      .to(cta, { scale: 1, duration: 0.5, ease: 'back.out(3)' }, 3.92)
      .to(cursor, { opacity: 0, duration: 0.6, ease: 'power1.out' }, 4.6);
    tl.timeScale(1.35); // ~35% quicker overall, same choreography
    tl.progress(0.001).pause();
    ScrollTrigger.create({ trigger: root, start: 'top 72%', once: true, onEnter: () => tl.play() });
  });
</script>
