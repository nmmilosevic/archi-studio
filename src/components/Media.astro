---
/**
 * Media — the only way images enter the page.
 * Handles: responsive srcset, aspect ratio, clip reveal, parallax layer,
 * and an optional view-transition hook for shared-element morphs.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;          // e.g. "3 / 2". Defaults to the image's own ratio.
  sizes?: string;
  reveal?: boolean;        // clip-path curtain on enter
  parallax?: number;       // 0 – .15, inner image drift while scrolling
  priority?: boolean;      // above the fold
  intro?: boolean;         // reveal as part of the page-load sequence
  eager?: boolean;         // skip lazy loading (e.g. inside a moving track)
  morph?: boolean;         // participates in the project-hero morph
  class?: string;
  [key: string]: unknown;
}

const {
  src, alt, ratio, sizes = '(min-width: 900px) 60vw, 100vw',
  reveal = true, parallax = 0, priority = false, intro = false, eager = false, morph = false,
  class: cls, ...rest
} = Astro.props;

const aspect = ratio ?? `${src.width} / ${src.height}`;
---
<div
  class:list={['media', cls]}
  style={`aspect-ratio:${aspect}`}
  data-reveal={reveal ? (intro ? 'intro' : '') : undefined}
  data-morph-target={morph ? '' : undefined}
  {...rest}
>
  <div class:list={['media__inner', { 'media__inner--parallax': parallax > 0 }]} data-parallax={parallax || undefined}>
    <Image
      src={src}
      alt={alt}
      widths={[480, 800, 1200, 1600, 1800].filter((w) => w <= src.width)}
      sizes={sizes}
      loading={priority || intro || eager ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </div>
</div>
