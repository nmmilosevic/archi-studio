---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { site } from '../data/site';
import { langs, href, swapLang, useContent, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useContent(lang);
const path = Astro.url.pathname;
const nav = [
  { label: t.ui.work, href: href(lang, '/work/') },
  { label: t.ui.services, href: href(lang, '/services/') },
  { label: t.ui.contact, href: href(lang, '/contact/') },
];
const isActive = (h: string) => path.startsWith(h);
---
<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a href={href(lang)} class="site-header__logo" aria-label={`Reframe Studio, ${t.ui.home}`}>
      <Logo class="logo" />
    </a>

    <nav class="site-header__nav" aria-label={t.ui.mainNav}>
      {nav.map((item) => (
        <a href={item.href} class="link link--quiet" aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__end">
      <nav class="lang" aria-label={t.ui.language}>
        {langs.map((l) => (
          <a href={swapLang(path, l)} class:list={['lang__item', { 'is-current': l === lang }]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
      <Button href={href(lang, '/contact/')} size="small" class="site-header__cta">{t.ui.cta}</Button>
      <button class="menu-toggle" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="roll"><span>{t.ui.menu}</span><span aria-hidden="true">{t.ui.close}</span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu data-theme="dark" hidden>
  <div class="wrap menu__inner">
    <nav class="menu__nav" aria-label={t.ui.mainNav}>
      <a href={href(lang)} class="t-h1" data-menu-link>{t.ui.home}</a>
      {nav.map((item) => (
        <a href={item.href} class="t-h1" data-menu-link aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="menu__foot" data-menu-foot>
      <a href={`mailto:${site.email}`} class="link">{site.email}</a>
      <div class="lang">
        {langs.map((l) => (
          <a href={swapLang(path, l)} class:list={['lang__item', { 'is-current': l === lang }]} hreflang={l} lang={l}>{l.toUpperCase()}</a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50;
    height: var(--header-h);
    color: var(--c-ink);
    transition: transform .7s var(--ease-out), background-color var(--d-base) var(--ease-soft), box-shadow var(--d-base) var(--ease-soft);
  }
  .site-header[data-scrolled] { background: rgb(10 10 10 / .82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 1px 0 var(--c-line); }
  .site-header[data-hidden] { transform: translateY(-101%); }
  .site-header[data-menu-open] { background: transparent; box-shadow: none; color: var(--c-ink); transform: none; }

  .site-header__inner {
    height: 100%;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--gutter);
  }
  .site-header__logo { justify-self: start; }
  .site-header__logo :global(.logo) { width: 5.75rem; height: auto; }
  /* Floating capsule behind the main links */
  .site-header__nav {
    display: flex; gap: .25rem; padding: .3rem;
    font-size: .9375rem;
    background: rgb(255 255 255 / .06); border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .08);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .site-header__nav a { padding: .45rem 1rem; border-radius: var(--radius-pill); background-image: none; transition: background-color var(--d-fast), color var(--d-fast); }
  .site-header__nav a:hover { background-color: rgb(255 255 255 / .08); }
  .site-header__nav a[aria-current="page"] { background-color: var(--c-ink); color: var(--c-black); }
  .site-header__end { justify-self: end; display: flex; align-items: center; gap: var(--s-5); }

  .lang { display: flex; gap: .875rem; font-size: var(--fs-label); font-weight: var(--fw-medium); }
  .lang__item { color: var(--fg-muted, var(--c-muted)); transition: color var(--d-fast); }
  .lang__item:hover, .lang__item.is-current { color: currentColor; }
  .site-header .lang__item { color: rgb(244 241 234 / .45); }
  .site-header .lang__item.is-current, .site-header .lang__item:hover { color: var(--c-ink); }

  .menu-toggle { display: none; font-size: .9375rem; font-weight: var(--fw-medium); height: 2.75rem; }
  .menu-toggle[aria-expanded="true"] > .roll > span:first-child { transform: translateY(-110%); }
  .menu-toggle[aria-expanded="true"] > .roll > span + span { transform: none; }

  @media (max-width: 899px) {
    .site-header__inner { grid-template-columns: 1fr auto; }
    .site-header__nav, .site-header__end .lang, .site-header__cta { display: none; }
    .menu-toggle { display: block; }
  }

  /* Mobile menu */
  .menu {
    position: fixed; inset: 0; z-index: 49;
    clip-path: inset(0 0 100% 0);
  }
  .menu[hidden] { display: none; }
  .menu__inner {
    height: 100%;
    display: flex; flex-direction: column; justify-content: space-between;
    padding-top: calc(var(--header-h) + var(--s-8));
    padding-bottom: var(--s-6);
  }
  .menu__nav { display: flex; flex-direction: column; gap: .15em; }
  .menu__nav a { display: block; width: fit-content; }
  .menu__nav a[aria-current="page"] { color: var(--c-sand); }
  .menu__foot { display: flex; justify-content: space-between; align-items: end; gap: var(--s-4); flex-wrap: wrap; }
</style>
