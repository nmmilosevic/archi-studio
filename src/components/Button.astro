---
/** Button / link with a rolling label and optional arrow. */
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'link';
  size?: 'default' | 'small';
  arrow?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'solid', size = 'default', arrow = false, type = 'button', class: cls, ...rest } = Astro.props;
const label = await Astro.slots.render('default');
const classes = [
  variant === 'link' ? 'link' : 'btn',
  variant === 'outline' && 'btn--outline',
  size === 'small' && 'btn--small',
  cls,
];
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : type} class:list={classes} {...rest}>
  {variant === 'link'
    ? <span set:html={label} />
    : <span class="roll"><span set:html={label} /><span aria-hidden="true" set:html={label} /></span>}
  {arrow && (
    <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.25" />
    </svg>
  )}
</Tag>
