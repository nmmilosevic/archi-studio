---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ServiceScene from '../../components/visuals/ServiceScene.astro';
import { langPaths, href, useContent, type Lang, rich } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useContent(lang);
const sv = t.services;
const { web, brand, print, social, between, engagement } = sv;
const contact = href(lang, '/contact/');

const v = sv.visuals;

// Line icons for "everything in between", same order as between.items (see .icon-draw)
const betweenIcons = [
  // Pitch deck: a screen, bars rise inside it
  `<svg class="icon-draw svc-between__icon ic-deck" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M5 8h38v24H5z" style="--i:0"/>
     <path class="d" pathLength="1" d="M24 32v8M16 40h16" style="--i:1"/>
     <g class="mv"><path class="d" pathLength="1" d="M15 26v-6M23 26V15M31 26v-8" style="--i:2"/></g>
   </svg>`,
  // Award submission: a medal, the star grows in
  `<svg class="icon-draw svc-between__icon ic-award" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M18 25l-4 18 10-5 10 5-4-18" style="--i:0"/>
     <path class="d f" pathLength="1" d="M24 4a12 12 0 1 1 0 24a12 12 0 1 1 0-24z" style="--i:1"/>
     <g class="mv"><path class="d" pathLength="1" d="M24 10l2.2 4.6 5 .6-3.7 3.4 1 5L24 21l-4.5 2.6 1-5-3.7-3.4 5-.6z" style="--i:2"/></g>
   </svg>`,
  // Project sheet: a page, the image drops into place
  `<svg class="icon-draw svc-between__icon ic-sheet" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M10 4h28v40H10z" style="--i:0"/>
     <path class="d" pathLength="1" d="M15 29h18M15 34h18M15 39h10" style="--i:1"/>
     <g class="mv"><path class="d" pathLength="1" d="M15 9h18v14H15z" style="--i:2"/></g>
   </svg>`,
  // Email signature: a signature is written above the line
  `<svg class="icon-draw svc-between__icon ic-sign" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M6 12h22M6 18h14" style="--i:0"/>
     <path class="d" pathLength="1" d="M6 40h36" style="--i:1"/>
     <path class="d" pathLength="1" d="M8 33c4-10 8-14 10-8s-2 10 2 8 6-12 9-10 2 8 6 6 5-4 7-4" style="--i:2"/>
   </svg>`,
  // Photo direction: a camera, the lens opens
  `<svg class="icon-draw svc-between__icon ic-camera" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M5 14h10l3-5h12l3 5h10v25H5z" style="--i:0"/>
     <g class="mv"><path class="d" pathLength="1" d="M24 19a7.5 7.5 0 1 1 0 15a7.5 7.5 0 1 1 0-15z" style="--i:1"/></g>
   </svg>`,
  // Website copy: lines of text, the cursor moves to the end
  `<svg class="icon-draw svc-between__icon ic-copy" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M6 12h36M6 20h36M6 28h24" style="--i:0"/>
     <g class="mv"><path class="d" pathLength="1" d="M34 24v10" style="--i:1"/></g>
   </svg>`,
];

// One line icon per process step. Paths use pathLength=1 so CSS can draw them.
const stepIcons = [
  // Review first: a page, then a magnifier slides over it
  `<svg class="svc-process__icon icon-review" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <path class="d" pathLength="1" d="M8 4h18l8 8v26H8z" style="--i:0"/>
     <path class="d" pathLength="1" d="M13 15h13M13 21h13M13 27h8" style="--i:1"/>
     <g class="mv"><circle class="d" pathLength="1" cx="34" cy="38" r="6.5" style="--i:2;fill:var(--bg)"/><path class="d" pathLength="1" d="m38.6 42.6 4.6 4.6" style="--i:3"/></g>
   </svg>`,
  // Fixed deliverables: three ticks, one after another
  `<svg class="svc-process__icon icon-list" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <path class="d" pathLength="1" d="m7 12 3 3 6-6" style="--i:0"/><path class="d" pathLength="1" d="M22 12h19" style="--i:0"/>
     <path class="d" pathLength="1" d="m7 24 3 3 6-6" style="--i:1"/><path class="d" pathLength="1" d="M22 24h19" style="--i:1"/>
     <path class="d" pathLength="1" d="m7 36 3 3 6-6" style="--i:2"/><path class="d" pathLength="1" d="M22 36h13" style="--i:2"/>
   </svg>`,
  // Direct involvement: two circles meet and overlap
  `<svg class="svc-process__icon icon-direct" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <g class="mv mv--l"><circle class="d" pathLength="1" cx="18" cy="24" r="10" style="--i:0"/></g>
     <g class="mv mv--r"><circle class="d" pathLength="1" cx="30" cy="24" r="10" style="--i:1"/></g>
   </svg>`,
  // Launch ready: a window, and an arrow rising inside it
  `<svg class="svc-process__icon icon-launch" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <path class="d" pathLength="1" d="M5 9h38v30H5z" style="--i:0"/>
     <path class="d" pathLength="1" d="M5 16h38" style="--i:1"/>
     <g class="mv"><path class="d" pathLength="1" d="M24 34V22M18.5 27.5 24 22l5.5 5.5" style="--i:2"/></g>
   </svg>`,
];

---
<Base lang={lang} title={t.meta.services.title} description={t.meta.services.description}>
  <!-- Hero, then the four disciplines as an index ------------------- -->
  <section class="wrap svc-hero">
    <div class="grid">
      <h1 class="t-h1 svc-hero__title" data-split="intro" set:html={rich(sv.title)}></h1>
      <p class="t-lead t-muted svc-hero__lead" data-fade="intro">{sv.lead}</p>
    </div>
    <ul class="grid svc-index" data-stagger="intro">
      {sv.disciplines.map((d) => (
        <li>
          <a href={`#${d.id}`} class="svc-index__link">
            <span class="t-h3">{d.name}</span>
            <span class="t-small t-muted">{d.line}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Web: laptop + phone visual (1–7) + text with three groups (8–12) -->
  <section class="wrap section svc-disc" id="web" aria-labelledby="svc-web">
    <div class="grid">
      <ServiceScene kind="web" label={v.web.label} class="svc-disc__media" />
      <div class="svc-disc__text">
        <h2 id="svc-web" class="t-h2" data-split>{web.title}</h2>
        <p class="t-lead t-muted" data-fade>{web.body}</p>
        <div class="svc-groups" data-stagger>
          {web.groups.map((g) => (
            <div class="svc-group">
              <h3 class="t-h4">{g.title}</h3>
              <ul class="t-small t-muted">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Brand: text (1–5) + brand board (6–12) ------------------------- -->
  <section class="wrap section svc-disc svc-disc--mirror" id="brand" aria-labelledby="svc-brand">
    <div class="grid">
      <div class="svc-disc__text">
        <h2 id="svc-brand" class="t-h2" data-split>{brand.title}</h2>
        <p class="t-lead t-muted" data-fade>{brand.body}</p>
        <div class="svc-groups" data-stagger>
          {brand.groups.map((g) => (
            <div class="svc-group">
              <h3 class="t-h4">{g.title}</h3>
              <ul class="t-small t-muted">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <ServiceScene kind="brand" label={v.brand.label} class="svc-disc__media" />
    </div>
  </section>

  <!-- Print: on a surface band, print set (1–7) + text (8–12) -------- -->
  <section class="svc-surface" id="print" aria-labelledby="svc-print">
    <div class="wrap section svc-disc">
      <div class="grid">
        <ServiceScene kind="print" label={v.print.label} class="svc-disc__media" />
        <div class="svc-disc__text">
          <h2 id="svc-print" class="t-h2" data-split>{print.title}</h2>
          <p class="t-lead t-muted" data-fade>{print.body}</p>
          <div class="svc-groups" data-stagger>
          {print.groups.map((g) => (
            <div class="svc-group">
              <h3 class="t-h4">{g.title}</h3>
              <ul class="t-small t-muted">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social & marketing: text (1–5) + phone and newsletter (6–12) --- -->
  <section class="wrap section svc-disc svc-disc--mirror" id="marketing" aria-labelledby="svc-social">
    <div class="grid">
      <div class="svc-disc__text">
        <h2 id="svc-social" class="t-h2" data-split>{social.title}</h2>
        <p class="t-lead t-muted" data-fade>{social.body}</p>
        <div class="svc-groups" data-stagger>
          {social.groups.map((g) => (
            <div class="svc-group">
              <h3 class="t-h4">{g.title}</h3>
              <ul class="t-small t-muted">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <ServiceScene kind="social" label={v.social.label} class="svc-disc__media" />
    </div>
  </section>

  <!-- Everything in between: six open items on a 3 × 2 grid --------- -->
  <section class="wrap section svc-between" aria-labelledby="svc-between">
    <div class="grid section-head">
      <h2 id="svc-between" class="t-h2" data-split set:html={rich(between.title)}></h2>
      <p class="t-muted" data-fade>{between.body}</p>
    </div>
    <ul class="svc-between__grid" data-stagger>
      {between.items.map((item, i) => (
        <li class="svc-between__item">
          <Fragment set:html={betweenIcons[i]} />
          <span class="t-h4">{item.title}</span>
          <p class="t-small t-muted">{item.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Not sure: a pause ---------------------------------------------- -->
  <section class="wrap section svc-fit" aria-labelledby="svc-fit">
    <h2 id="svc-fit" class="t-h1" data-split set:html={rich(sv.fit.title)}></h2>
    <div class="svc-fit__body" data-stagger>
      <p class="t-lead t-muted">{sv.fit.body}</p>
      <div><Button href={contact} arrow>{sv.fit.action}</Button></div>
    </div>
  </section>

  <!-- Engagement: a timeline that draws as you scroll ----------------- -->
  <section class="svc-process" aria-labelledby="svc-process">
    <div class="wrap section">
      <h2 id="svc-process" class="t-h2 svc-process__title" data-split set:html={rich(engagement.title)}></h2>
      <ol class="svc-process__steps" data-process>
        <span class="svc-process__track" aria-hidden="true"><span data-process-line></span></span>
        {engagement.items.map((e, i) => (
          <li class="svc-process__step" data-fade>
            <span class="svc-process__mark" aria-hidden="true"></span>
            <Fragment set:html={stepIcons[i]} />
            <h3 class="t-h4">{e.title}</h3>
            <p class="t-small t-muted">{e.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style is:global>
  /* Hero */
  .svc-hero { padding-top: calc(var(--header-h) + var(--s-9)); padding-bottom: var(--s-section); }
  .svc-hero .grid { row-gap: var(--s-7); }
  .svc-hero__lead { max-width: 34rem; }
  @media (min-width: 900px) {
    .svc-hero__title { grid-column: 1 / span 8; }
    .svc-hero__lead { grid-column: 9 / -1; align-self: end; }
  }

  /* Discipline index: four anchors, 3 columns each, hairline above */
  .svc-index { margin-top: var(--s-9); row-gap: var(--s-6); }
  .svc-index > li { grid-column: span 6; border-top: 1px solid var(--c-line); }
  .svc-index__link { display: grid; gap: var(--s-2); padding-top: var(--s-5); }
  .svc-index__link .t-h3 { transition: color var(--d-fast); }
  @media (hover: hover) { .svc-index__link:hover .t-h3 { color: var(--accent); } }
  @media (min-width: 900px) { .svc-index > li { grid-column: span 3; } }

  /* Discipline sections: visual 7 cols + text 5 cols; mirror flips them */
  .svc-disc { scroll-margin-top: var(--header-h); }
  .svc-disc .grid { row-gap: var(--s-7); align-items: center; }
  .svc-disc__text { display: grid; gap: var(--s-5); align-content: start; }
  .svc-disc__list { margin-top: var(--s-3); }
  @media (min-width: 600px) { .svc-disc__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); } }
  @media (min-width: 900px) {
    .svc-disc .svc-disc__media { grid-column: 1 / span 7; grid-row: 1; }
    .svc-disc .svc-disc__text { grid-column: 8 / -1; grid-row: 1; }
    .svc-disc--mirror .svc-disc__text { grid-column: 1 / span 5; }
    .svc-disc--mirror .svc-disc__media { grid-column: 6 / -1; }
    .svc-disc__list { grid-template-columns: 1fr; }
  }
  .svc-surface { background: var(--c-stone-deep); scroll-margin-top: var(--header-h); }

  /* Web: three groups, hairline above each */
  .svc-groups { display: grid; gap: var(--s-5); margin-top: var(--s-3); }
  .svc-group { display: grid; gap: var(--s-2); padding-top: var(--s-4); border-top: 1px solid var(--c-line); }
  .svc-group ul { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }

  /* Everything in between: 3 × 2 open grid, inner lines that overshoot and fade,
     drawn in with the items (same pattern as the homepage "What's included") */
  .svc-between__grid {
    --ext: min(var(--s-8), var(--margin));
    position: relative; display: grid; grid-template-columns: 1fr;
  }
  .svc-between__item {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--s-4); row-gap: var(--s-2); align-items: center; align-content: center; /* content centred in each cell */
    padding: var(--s-5) 0;
  }
  .svc-between__item > p { grid-column: 2; max-width: 30ch; }
  .svc-between__icon { --icon-bg: var(--bg); width: 2.25rem; height: 2.25rem; }
  .svc-between__item + .svc-between__item::before {
    content: ''; position: absolute; top: 0; height: 1px;
    left: calc(var(--margin) * -1); width: calc(100% + var(--margin) * 2);
    background: linear-gradient(to right, transparent, var(--c-line) var(--margin), var(--c-line) calc(100% - var(--margin)), transparent);
  }
  @media (min-width: 900px) {
    /* 4 + 4 + 4 columns with the real gutter, so every item starts on a column line */
    .svc-between__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); grid-auto-rows: 1fr; }
    .svc-between__item { padding: var(--s-6) 0; }
    .svc-between__item + .svc-between__item::before { content: none; }
    /* Two vertical lines between the columns */
    .svc-between__grid::before, .svc-between__grid::after {
      content: ''; position: absolute; width: 1px;
      top: calc(var(--ext) * -1); bottom: calc(var(--ext) * -1);
      background: linear-gradient(to bottom, transparent, var(--c-line) var(--ext), var(--c-line) calc(100% - var(--ext)), transparent);
    }
    /* centred in the two gutters */
    .svc-between__grid::before { left: calc((100% - var(--gutter) * 2) / 3 + var(--gutter) / 2); }
    .svc-between__grid::after { left: calc((100% - var(--gutter) * 2) / 3 * 2 + var(--gutter) * 1.5); }
    /* One horizontal line between the two rows, across all three columns */
    .svc-between__item:nth-child(4)::before {
      content: ''; position: absolute; top: 0; height: 1px;
      left: calc(var(--ext) * -1); width: calc(300% + var(--gutter) * 2 + var(--ext) * 2);
      background: linear-gradient(to right, transparent, var(--c-line) var(--ext), var(--c-line) calc(100% - var(--ext)), transparent);
    }
  }
  html.js:not(.motion-off) .svc-between__grid::before,
  html.js:not(.motion-off) .svc-between__grid::after,
  html.js:not(.motion-off) .svc-between__item::before { transition: transform 1.4s var(--ease-out); }
  html.js:not(.motion-off) .svc-between__grid::before,
  html.js:not(.motion-off) .svc-between__grid::after { transform: scaleY(0); transform-origin: 50% 0; }
  html.js:not(.motion-off) .svc-between__grid::after { transition-delay: .15s; }
  html.js:not(.motion-off) .svc-between__item::before { transform: scaleX(0); transform-origin: 0 50%; transition-delay: .3s; }
  html.js:not(.motion-off) .svc-between__grid.is-in::before,
  html.js:not(.motion-off) .svc-between__grid.is-in::after,
  html.js:not(.motion-off) .svc-between__grid.is-in > li::before { transform: none; }
  html.js:not(.motion-off) .ic-deck .mv { transform: scaleY(0); }
  .ic-deck .mv { transform-origin: 24px 26px; }
  html.js:not(.motion-off) .ic-award .mv { transform: scale(.3); }
  .ic-award .mv { transform-origin: 24px 16px; }
  html.js:not(.motion-off) .ic-sheet .mv { transform: translateY(-6px); }
  html.js:not(.motion-off) .ic-camera .mv { transform: scale(.4); }
  .ic-camera .mv { transform-origin: 24px 26.5px; }
  html.js:not(.motion-off) .ic-copy .mv { transform: translateX(-20px); }

  /* Fit: a centred pause */
  .svc-fit { display: grid; justify-items: center; gap: var(--s-6); text-align: center; }
  .svc-fit h2 { max-width: 14ch; }
  .svc-fit__body { display: grid; gap: var(--s-6); justify-items: center; max-width: 30rem; }

  /* Process timeline */
  .svc-process__title { max-width: 16ch; margin-bottom: var(--s-8); }
  .svc-process__steps { position: relative; display: grid; gap: var(--s-7); padding-left: var(--s-6); }
  .svc-process__track { position: absolute; left: 4px; top: 0; bottom: 0; width: 1px; background: var(--rule); }
  .svc-process__track span { position: absolute; inset: 0; background: var(--fg); transform-origin: 50% 0; transform: scaleY(0); }
  .svc-process__step { position: relative; display: grid; gap: var(--s-3); align-content: start; max-width: 24rem; }
  .svc-process__mark {
    position: absolute; left: calc(var(--s-6) * -1); top: .45em;
    width: 9px; height: 9px; background: var(--bg); box-shadow: inset 0 0 0 1px var(--fg);
    transition: background-color var(--d-base) var(--ease-soft);
  }
  .svc-process__step.is-reached .svc-process__mark { background: var(--fg); }

  /* Step icons: drawn when the timeline reaches their step */
  .svc-process__icon { width: 3rem; height: 3rem; margin-bottom: var(--s-3); color: var(--fg); overflow: visible; }
  .svc-process__icon .d { stroke: currentColor; stroke-width: 1.5; stroke-linecap: square; }
  .svc-process__icon .mv { transform-box: view-box; transition: transform 1.1s var(--ease-out) .55s; }
  html.js:not(.motion-off) .svc-process__icon .d {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset .9s var(--ease-out) calc(var(--i, 0) * .14s);
  }
  html.js:not(.motion-off) .is-reached .svc-process__icon .d { stroke-dashoffset: 0; }
  html.js:not(.motion-off) .icon-review .mv { transform: translate(-7px, -9px); }
  html.js:not(.motion-off) .icon-direct .mv--l { transform: translateX(-7px); }
  html.js:not(.motion-off) .icon-direct .mv--r { transform: translateX(7px); }
  html.js:not(.motion-off) .icon-launch .mv { transform: translateY(7px); }
  html.js:not(.motion-off) .is-reached .svc-process__icon .mv { transform: none; }
  @media (min-width: 900px) {
    .svc-process__steps { grid-template-columns: repeat(4, 1fr); column-gap: var(--gutter); padding-left: 0; padding-top: var(--s-7); }
    .svc-process__track { left: 0; right: 0; top: 4px; bottom: auto; width: auto; height: 1px; }
    .svc-process__track span { transform-origin: 0 50%; transform: scaleX(0); }
    .svc-process__mark { left: 0; top: calc(var(--s-7) * -1); }
  }

</style>

<script>
  import { gsap, ScrollTrigger, reduced, ready } from '../../scripts/motion';

  ready.then(() => {
    // Everything in between: lines draw in with the items (same start as data-stagger)
    document.querySelectorAll<HTMLElement>('.svc-between__grid').forEach((list) => {
      ScrollTrigger.create({ trigger: list, start: 'top 88%', once: true, onEnter: () => list.classList.add('is-in') });
    });

    const steps = document.querySelector<HTMLElement>('[data-process]');
    const line = document.querySelector<HTMLElement>('[data-process-line]');
    if (!steps || !line) return;
    const items = Array.from(steps.querySelectorAll<HTMLElement>('.svc-process__step'));
    if (reduced) { items.forEach((i) => i.classList.add('is-reached')); line.style.transform = 'none'; return; }

    // The line draws through the steps; each marker fills as the line reaches it.
    const mm = gsap.matchMedia();
    mm.add({ desktop: '(min-width: 900px)', mobile: '(max-width: 899px)' }, (ctx) => {
      const horizontal = ctx.conditions!.desktop;
      gsap.fromTo(line, horizontal ? { scaleX: 0 } : { scaleY: 0 }, {
        ...(horizontal ? { scaleX: 1 } : { scaleY: 1 }),
        ease: 'none',
        scrollTrigger: {
          trigger: steps, start: 'top 75%', end: horizontal ? 'top 30%' : 'bottom 60%', scrub: 0.5,
          onUpdate: (st) => items.forEach((item, i) => item.classList.toggle('is-reached', st.progress >= i / items.length)),
        },
      });
    });
    ScrollTrigger.refresh();
  });
</script>
