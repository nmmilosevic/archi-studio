---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Media from '../../components/Media.astro';
import SearchVisual from '../../components/visuals/SearchVisual.astro';
import PortfolioVisual from '../../components/visuals/PortfolioVisual.astro';
import BrandVisual from '../../components/visuals/BrandVisual.astro';
import HostingVisual from '../../components/visuals/HostingVisual.astro';
import { serviceImages } from '../../data/site';
import { langPaths, href, useContent, type Lang, rich } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useContent(lang);
const sv = t.services;
const engagement = sv.engagement;

// Same six services, same copy. Each one gets its own layout.
const { redesign, interiors, search, hosting, portfolio, brand } = sv;

// Line icons for the six search features, same order as search.items (see .icon-draw)
const searchIcons = [
  // SEO metadata: brackets close in around a slash
  `<svg class="icon-draw svc-feature__icon ic-meta" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <g class="mv mv--l"><path class="d" pathLength="1" d="m15 15-8 9 8 9" style="--i:0"/></g>
     <g class="mv mv--r"><path class="d" pathLength="1" d="m33 15 8 9-8 9" style="--i:0"/></g>
     <path class="d" pathLength="1" d="m28 11-8 26" style="--i:1"/>
   </svg>`,
  // Page structure: heading bars slide into a hierarchy
  `<svg class="icon-draw svc-feature__icon ic-structure" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M8 5h32v38H8z" style="--i:0"/>
     <g class="mv"><path class="d" pathLength="1" d="M14 13h20" style="--i:1"/><path class="d" pathLength="1" d="M14 21h14M14 27h14" style="--i:2"/><path class="d" pathLength="1" d="M18 34h10" style="--i:3"/></g>
   </svg>`,
  // Structured data: a small tree of nodes
  `<svg class="icon-draw svc-feature__icon ic-tree" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M20 6h8v8h-8z" style="--i:0"/>
     <path class="d" pathLength="1" d="M24 14v8M24 22H12v8M24 22h12v8" style="--i:1"/>
     <g class="mv"><path class="d" pathLength="1" d="M8 30h8v8H8zM32 30h8v8h-8z" style="--i:2"/></g>
   </svg>`,
  // Internal linking: two links join
  `<svg class="icon-draw svc-feature__icon ic-link" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <g class="mv mv--l"><path class="d" pathLength="1" d="m21 29-4 4a6 6 0 0 1-8.5-8.5l5-5a6 6 0 0 1 8.5 0" style="--i:0"/></g>
     <g class="mv mv--r"><path class="d" pathLength="1" d="m27 19 4-4a6 6 0 0 1 8.5 8.5l-5 5a6 6 0 0 1-8.5 0" style="--i:0"/></g>
     <path class="d" pathLength="1" d="m19.5 28.5 9-9" style="--i:2"/>
   </svg>`,
  // Image alt: a picture with its caption line
  `<svg class="icon-draw svc-feature__icon ic-alt" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M6 7h36v26H6z" style="--i:0"/>
     <path class="d" pathLength="1" d="m6 29 11-10 8 7 6-5 11 9" style="--i:1"/>
     <circle class="d" pathLength="1" cx="33" cy="14" r="2.5" style="--i:2"/>
     <g class="mv"><path class="d" pathLength="1" d="M6 40h22" style="--i:3"/></g>
   </svg>`,
  // Performance: the needle swings up the gauge
  `<svg class="icon-draw svc-feature__icon ic-gauge" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M7 34a17 17 0 0 1 34 0" style="--i:0"/>
     <path class="d" pathLength="1" d="M11 22.5l2.5 1.6M24 17v3M37 22.5l-2.5 1.6" style="--i:1"/>
     <g class="mv"><path class="d" pathLength="1" d="m24 34 9-10" style="--i:2"/></g>
   </svg>`,
];

// Line icons for the five hosting tasks, same order as hosting.items (see .icon-draw)
const hostIcons = [
  // Hosting setup: two server units, lights come on
  `<svg class="icon-draw svc-host__icon ic-server" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M7 9h34v12H7zM7 27h34v12H7z" style="--i:0"/>
     <g class="mv"><path class="d" pathLength="1" d="M13 15h3M13 33h3" style="--i:2"/></g>
     <path class="d" pathLength="1" d="M24 15h11M24 33h11" style="--i:1"/>
   </svg>`,
  // Monthly updates: a calendar gets ticked
  `<svg class="icon-draw svc-host__icon ic-cal" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M7 10h34v31H7zM7 18h34M16 6v8M32 6v8" style="--i:0"/>
     <g class="mv"><path class="d" pathLength="1" d="m17 29 5 5 9-10" style="--i:2"/></g>
   </svg>`,
  // Monitoring: a pulse line runs across
  `<svg class="icon-draw svc-host__icon ic-pulse" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M4 26h9l4-10 6 20 5-14 3 4h13" style="--i:0"/>
   </svg>`,
  // Content edits: a pencil writes a line
  `<svg class="icon-draw svc-host__icon ic-edit" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <g class="mv"><path class="d" pathLength="1" d="M30 8l8 8-18 18-10 2 2-10z M26 12l8 8" style="--i:0"/></g>
     <path class="d" pathLength="1" d="M8 42h32" style="--i:2"/>
   </svg>`,
  // Analytics: bars rise
  `<svg class="icon-draw svc-host__icon ic-bars" viewBox="0 0 48 48" aria-hidden="true" data-draw>
     <path class="d" pathLength="1" d="M6 41h36" style="--i:0"/>
     <g class="mv"><path class="d" pathLength="1" d="M12 36V27M21 36V20M30 36V24M39 36V11" style="--i:1"/></g>
   </svg>`,
];

// One line icon per process step. Paths use pathLength=1 so CSS can draw them.
const stepIcons = [
  // Review first: a page, then a magnifier slides over it
  `<svg class="svc-process__icon icon-review" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <path class="d" pathLength="1" d="M8 4h18l8 8v26H8z" style="--i:0"/>
     <path class="d" pathLength="1" d="M13 15h13M13 21h13M13 27h8" style="--i:1"/>
     <g class="mv"><circle class="d" pathLength="1" cx="34" cy="38" r="6.5" style="--i:2;fill:var(--bg)"/><path class="d" pathLength="1" d="m38.6 42.6 4.6 4.6" style="--i:3"/></g>
   </svg>`,
  // Fixed deliverables: three ticks, one after another
  `<svg class="svc-process__icon icon-list" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <path class="d" pathLength="1" d="m7 12 3 3 6-6" style="--i:0"/><path class="d" pathLength="1" d="M22 12h19" style="--i:0"/>
     <path class="d" pathLength="1" d="m7 24 3 3 6-6" style="--i:1"/><path class="d" pathLength="1" d="M22 24h19" style="--i:1"/>
     <path class="d" pathLength="1" d="m7 36 3 3 6-6" style="--i:2"/><path class="d" pathLength="1" d="M22 36h13" style="--i:2"/>
   </svg>`,
  // Direct involvement: two circles meet and overlap
  `<svg class="svc-process__icon icon-direct" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <g class="mv mv--l"><circle class="d" pathLength="1" cx="18" cy="24" r="10" style="--i:0"/></g>
     <g class="mv mv--r"><circle class="d" pathLength="1" cx="30" cy="24" r="10" style="--i:1"/></g>
   </svg>`,
  // Launch ready: a window, and an arrow rising inside it
  `<svg class="svc-process__icon icon-launch" viewBox="0 0 48 48" fill="none" aria-hidden="true">
     <path class="d" pathLength="1" d="M5 9h38v30H5z" style="--i:0"/>
     <path class="d" pathLength="1" d="M5 16h38" style="--i:1"/>
     <g class="mv"><path class="d" pathLength="1" d="M24 34V22M18.5 27.5 24 22l5.5 5.5" style="--i:2"/></g>
   </svg>`,
];
const ids = ['website-redesign', 'interior-websites', 'portfolio-systems', 'search-visibility', 'brand-refinement', 'hosting'];
---
<Base lang={lang} title={t.meta.services.title} description={t.meta.services.description}>
  <!-- Hero + index --------------------------------------------------- -->
  <section class="wrap svc-hero">
    <div class="grid">
      <h1 class="t-h1 svc-hero__title" data-split="intro" set:html={rich(sv.title)}></h1>
      <p class="t-lead t-muted svc-hero__lead" data-fade="intro">{sv.lead}</p>
    </div>
  </section>

  <!-- Websites: two services side by side, image-led ------------------ -->
  <section class="wrap svc-duo" aria-label="Websites">
    <div class="grid">
      {[
        { s: redesign, id: ids[0], image: serviceImages.redesign },
        { s: interiors, id: ids[1], image: serviceImages.interiors },
      ].map(({ s, id, image }) => (
        <article class="svc-duo__item" id={id}>
          <Media src={image} alt={s.alt} ratio="4 / 3" sizes="(min-width: 900px) 46vw, 100vw" />
          <h2 class="t-h3" data-split>{s.title}</h2>
          <p class="t-muted" data-fade>{s.body}</p>
          <ul class="svc-duo__items list-marked t-small" data-stagger>
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Portfolio systems: wide image, text beside ---------------------- -->
  <section class="wrap section svc-split" id={ids[2]} aria-labelledby="svc-portfolio">
    <div class="grid">
      <PortfolioVisual lang={lang} class="svc-split__media" />
      <div class="svc-split__text">
        <h2 id="svc-portfolio" class="t-h2" data-split>{portfolio.title}</h2>
        <p class="t-lead" data-fade>{portfolio.body}</p>
        <ul class="list-marked t-small" data-stagger>
          {portfolio.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Search visibility: typographic statement on a surface ---------- -->
  <section class="svc-statement" id={ids[3]} aria-labelledby="svc-search">
    <div class="wrap section">
      <div class="grid">
        <h2 id="svc-search" class="t-h2 svc-statement__title" data-split>{search.title}</h2>
        <p class="t-h3 svc-statement__body" data-fade>{search.body}</p>
        <ul class="grid svc-statement__items" data-stagger>
          {search.items.map((item, i) => <li class="card card--raised t-small svc-feature"><Fragment set:html={searchIcons[i]} /><span>{item}</span></li>)}
        </ul>
        <SearchVisual lang={lang} class="svc-statement__visual" />
      </div>
    </div>
  </section>

  <!-- Brand refinement: mirrored split -------------------------------- -->
  <section class="wrap section svc-split svc-split--mirror" id={ids[4]} aria-labelledby="svc-brand">
    <div class="grid">
      <div class="svc-split__text">
        <h2 id="svc-brand" class="t-h2" data-split>{brand.title}</h2>
        <p class="t-lead" data-fade>{brand.body}</p>
        <ul class="list-marked t-small" data-stagger>
          {brand.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <BrandVisual lang={lang} class="svc-split__media" />
    </div>
  </section>

  <!-- Hosting: compact dark band ------------------------------------- -->
  <section class="svc-band" id={ids[5]} data-theme="dark" aria-labelledby="svc-hosting">
    <div class="wrap">
      <div class="grid svc-band__grid">
        <h2 id="svc-hosting" class="t-h2 svc-band__title" data-split>{hosting.title}</h2>
        <p class="t-muted svc-band__body" data-fade>{hosting.body}</p>
        <HostingVisual lang={lang} class="svc-band__visual" />
        <ul class="svc-band__items t-small" data-stagger>
          {hosting.items.map((item, i) => <li class="card svc-host"><Fragment set:html={hostIcons[i]} /><span>{item}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Not sure: a pause ---------------------------------------------- -->
  <section class="wrap section svc-fit" aria-labelledby="svc-fit">
    <h2 id="svc-fit" class="t-h1" data-split set:html={rich(sv.fit.title)}></h2>
    <div class="svc-fit__body" data-stagger>
      <p class="t-lead t-muted">{sv.fit.body}</p>
      <div><Button href={href(lang, '/contact/')} arrow>{sv.fit.action}</Button></div>
    </div>
  </section>

  <!-- Engagement: a timeline that draws as you scroll ----------------- -->
  <section class="svc-process" aria-labelledby="svc-process">
    <div class="wrap section">
      <h2 id="svc-process" class="t-h2 svc-process__title" data-split set:html={rich(engagement.title)}></h2>
      <ol class="svc-process__steps" data-process>
        <span class="svc-process__track" aria-hidden="true"><span data-process-line></span></span>
        {engagement.items.map((e, i) => (
          <li class="svc-process__step" data-fade>
            <span class="svc-process__mark" aria-hidden="true"></span>
            <Fragment set:html={stepIcons[i]} />
            <h3 class="t-h4">{e.title}</h3>
            <p class="t-small t-muted">{e.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

</Base>

<style is:global>
  /* Hero with index */
  .svc-hero { padding-top: calc(var(--header-h) + var(--s-9)); padding-bottom: var(--s-section); }
  .svc-hero .grid { row-gap: var(--s-7); }
  .svc-hero__lead { max-width: 32rem; }
  @media (min-width: 900px) {
    .svc-hero__title { grid-column: 1 / span 9; }
    .svc-hero__lead { grid-column: 1 / span 5; align-self: start; }
  }

  /* Duo: two image-led services, second one staggered lower */
  .svc-duo .grid { row-gap: var(--s-9); }
  .svc-duo__item { display: grid; gap: var(--s-4); align-content: start; scroll-margin-top: var(--header-h); }
  .svc-duo__item .media { margin-bottom: var(--s-3); }
  .svc-duo__item > p { max-width: 34rem; }
  .svc-duo__items { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-2); }
  @media (min-width: 900px) {
    .svc-duo__item:nth-child(1) { grid-column: 1 / span 6; }
    .svc-duo__item:nth-child(2) { grid-column: 8 / -1; margin-top: var(--s-section); }
  }

  /* Split: big image + text column; mirror flips it */
  .svc-split { scroll-margin-top: var(--header-h); }
  .svc-split .grid { row-gap: var(--s-7); align-items: center; }
  .svc-split__text { display: grid; gap: var(--s-5); }
  .svc-split__text .list-marked { margin-top: var(--s-3); }
  @media (min-width: 900px) {
    .svc-split__media { grid-column: 1 / span 7; }
    .svc-split__text { grid-column: 9 / -1; }
    .svc-split--mirror .svc-split__text { grid-column: 1 / span 5; grid-row: 1; }
    .svc-split--mirror .svc-split__media { grid-column: 7 / -1; grid-row: 1; }
  }

  /* Statement: text-only, on a surface */
  .svc-statement { background: var(--c-stone-deep); scroll-margin-top: var(--header-h); }
  .svc-statement .grid { row-gap: var(--s-7); }
  .svc-statement__body { text-wrap: pretty; }
  .svc-statement .svc-statement__items { gap: var(--gutter); }
  .svc-statement__items li { padding-block: var(--s-5); }
  .svc-band .svc-host { display: flex; align-items: center; gap: var(--s-4); }
  .svc-host__icon { width: 2.25rem; height: 2.25rem; flex: none; }
  html.js:not(.motion-off) .ic-server .mv { opacity: 0; transition: opacity .4s 1s, transform 1.1s var(--ease-out) .55s; }
  html.js:not(.motion-off) .ic-server.is-drawn .mv { opacity: 1; }
  html.js:not(.motion-off) .ic-cal .mv { transform: scale(.6); }
  .ic-cal .mv { transform-origin: 24px 29px; }
  html.js:not(.motion-off) .ic-edit .mv { transform: translate(-8px, 6px); }
  html.js:not(.motion-off) .ic-bars .mv { transform: scaleY(0); }
  .ic-bars .mv { transform-origin: 24px 36px; }
  .svc-statement .svc-feature { display: flex; align-items: center; gap: var(--s-4); }
  .svc-feature__icon { width: 2.25rem; height: 2.25rem; flex: none; }
  html.js:not(.motion-off) .ic-meta .mv--l { transform: translateX(-5px); }
  html.js:not(.motion-off) .ic-meta .mv--r { transform: translateX(5px); }
  html.js:not(.motion-off) .ic-structure .mv { transform: translateX(-6px); }
  html.js:not(.motion-off) .ic-tree .mv { transform: translateY(-5px); }
  html.js:not(.motion-off) .ic-link .mv--l { transform: translate(-4px, 4px); }
  html.js:not(.motion-off) .ic-link .mv--r { transform: translate(4px, -4px); }
  html.js:not(.motion-off) .ic-alt .mv { transform: translateX(-8px); }
  html.js:not(.motion-off) .ic-gauge .mv { transform: rotate(-95deg); }
  .ic-gauge .mv { transform-origin: 24px 34px; }
  @media (min-width: 900px) {
    .svc-statement__title { grid-column: 1 / span 5; }
    .svc-statement__body { grid-column: 7 / -1; }
    .svc-statement__items { grid-column: 7 / -1; grid-row: 2; grid-template-columns: repeat(2, 1fr); }
    .svc-statement__visual { grid-column: 1 / span 5; grid-row: 2 / span 2; align-self: start; }
    .svc-statement__items li { grid-column: auto; }
  }
  @media (max-width: 899px) {
    .svc-statement__items { grid-template-columns: repeat(2, 1fr); }
    .svc-statement__items li { grid-column: auto; }
  }

  /* Band: compact dark strip */
  .svc-band { padding-block: var(--s-9); scroll-margin-top: var(--header-h); }
  .svc-band__grid { row-gap: var(--s-6); align-items: start; }
  .svc-band__items { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--gutter); }
  .svc-band__items li { padding-block: var(--s-5); }
  @media (min-width: 900px) {
    .svc-band__title { grid-column: 1 / span 5; grid-row: 1; }
    .svc-band__body { grid-column: 1 / span 5; grid-row: 2; max-width: 32rem; }
    .svc-band__visual { grid-column: 7 / -1; grid-row: 1 / span 2; }
    .svc-band__items { grid-column: 1 / -1; margin-top: var(--s-5); }
  }

  /* Fit: a centred pause */
  .svc-fit { display: grid; justify-items: center; gap: var(--s-6); text-align: center; }
  .svc-fit h2 { max-width: 14ch; }
  .svc-fit__body { display: grid; gap: var(--s-6); justify-items: center; max-width: 30rem; }

  /* Process timeline */
  .svc-process__title { max-width: 16ch; margin-bottom: var(--s-8); }
  .svc-process__steps { position: relative; display: grid; gap: var(--s-7); padding-left: var(--s-6); }
  .svc-process__track { position: absolute; left: 4px; top: 0; bottom: 0; width: 1px; background: var(--rule); }
  .svc-process__track span { position: absolute; inset: 0; background: var(--fg); transform-origin: 50% 0; transform: scaleY(0); }
  .svc-process__step { position: relative; display: grid; gap: var(--s-3); align-content: start; max-width: 24rem; }
  .svc-process__mark {
    position: absolute; left: calc(var(--s-6) * -1); top: .45em;
    width: 9px; height: 9px; background: var(--bg); box-shadow: inset 0 0 0 1px var(--fg);
    transition: background-color var(--d-base) var(--ease-soft);
  }
  .svc-process__step.is-reached .svc-process__mark { background: var(--fg); }

  /* Step icons: drawn when the timeline reaches their step */
  .svc-process__icon { width: 3rem; height: 3rem; margin-bottom: var(--s-3); color: var(--fg); overflow: visible; }
  .svc-process__icon .d { stroke: currentColor; stroke-width: 1.5; stroke-linecap: square; }
  .svc-process__icon .mv { transform-box: view-box; transition: transform 1.1s var(--ease-out) .55s; }
  html.js:not(.motion-off) .svc-process__icon .d {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset .9s var(--ease-out) calc(var(--i, 0) * .14s);
  }
  html.js:not(.motion-off) .is-reached .svc-process__icon .d { stroke-dashoffset: 0; }
  html.js:not(.motion-off) .icon-review .mv { transform: translate(-7px, -9px); }
  html.js:not(.motion-off) .icon-direct .mv--l { transform: translateX(-7px); }
  html.js:not(.motion-off) .icon-direct .mv--r { transform: translateX(7px); }
  html.js:not(.motion-off) .icon-launch .mv { transform: translateY(7px); }
  html.js:not(.motion-off) .is-reached .svc-process__icon .mv { transform: none; }
  @media (min-width: 900px) {
    .svc-process__steps { grid-template-columns: repeat(4, 1fr); column-gap: var(--gutter); padding-left: 0; padding-top: var(--s-7); }
    .svc-process__track { left: 0; right: 0; top: 4px; bottom: auto; width: auto; height: 1px; }
    .svc-process__track span { transform-origin: 0 50%; transform: scaleX(0); }
    .svc-process__mark { left: 0; top: calc(var(--s-7) * -1); }
  }

</style>

<script>
  import { gsap, ScrollTrigger, reduced, ready } from '../../scripts/motion';

  ready.then(() => {
    const steps = document.querySelector<HTMLElement>('[data-process]');
    const line = document.querySelector<HTMLElement>('[data-process-line]');
    if (!steps || !line) return;
    const items = Array.from(steps.querySelectorAll<HTMLElement>('.svc-process__step'));
    if (reduced) { items.forEach((i) => i.classList.add('is-reached')); line.style.transform = 'none'; return; }

    // The line draws through the steps; each marker fills as the line reaches it.
    const mm = gsap.matchMedia();
    mm.add({ desktop: '(min-width: 900px)', mobile: '(max-width: 899px)' }, (ctx) => {
      const horizontal = ctx.conditions!.desktop;
      gsap.fromTo(line, horizontal ? { scaleX: 0 } : { scaleY: 0 }, {
        ...(horizontal ? { scaleX: 1 } : { scaleY: 1 }),
        ease: 'none',
        scrollTrigger: {
          trigger: steps, start: 'top 75%', end: horizontal ? 'top 30%' : 'bottom 60%', scrub: 0.5,
          onUpdate: (st) => items.forEach((item, i) => item.classList.toggle('is-reached', st.progress >= i / items.length)),
        },
      });
    });
    ScrollTrigger.refresh();
  });
</script>
