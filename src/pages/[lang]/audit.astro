---
/** Old URL from the previous site: /{lang}/audit/ now lives at /{lang}/contact/ */
import Redirect from '../../components/Redirect.astro';
import { langPaths, href, type Lang } from '../../i18n';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---
<Redirect to={href(lang, '/contact/'.replace(/#.*/, '')) + ('/contact/'.includes('#') ? '#' + '/contact/'.split('#')[1] : '')} />
