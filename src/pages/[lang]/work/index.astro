---
import Base from '../../../layouts/Base.astro';
import Media from '../../../components/Media.astro';
import { projects } from '../../../data/site';
import { langPaths, href, useContent, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useContent(lang);
---
<Base lang={lang} title={t.meta.work.title} description={t.meta.work.description}>
  <section class="wrap page-hero">
    <div class="grid">
      <h1 class="t-h1 page-hero__title" data-split="intro">{t.work.title}</h1>
      <p class="t-lead t-muted page-hero__lead" data-fade="intro">{t.work.lead}</p>
    </div>
  </section>

  <section class="wrap work-list" aria-labelledby="studies">
    <h2 id="studies" class="sr-only">{t.work.listTitle}</h2>
    <ul class="grid work-list__grid">
      {projects.map((base) => {
        const p = t.projects[base.slug];
        return (
          <li class="work-card">
            <a href={href(lang, `/work/${base.slug}/`)} data-morph-link>
              <Media src={base.cover} alt={t.work.previewAlt(p.title)} ratio="3 / 2" sizes="(min-width: 900px) 58vw, 100vw" />
              <div class="work-card__meta" data-fade>
                <div class="work-card__head">
                  <h3 class="t-h3">{p.title}</h3>
                  <span class="t-small t-muted">{p.location}</span>
                </div>
                <p class="t-small t-muted work-card__summary">{p.summary}</p>
                <span class="link link--quiet work-card__cta">{t.work.viewProject}</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style is:global>
  .work-list { padding-bottom: var(--s-section); }
  .work-list__grid { row-gap: var(--s-9); }
  .work-card a { display: grid; gap: var(--s-5); }
  .work-card .media__inner { transition: transform 1.2s var(--ease-out); }
  .work-card a:hover .media__inner { transform: scale(1.035); }
  .work-card__meta { display: grid; gap: var(--s-3); }
  .work-card__head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); flex-wrap: wrap; }
  .work-card__summary { max-width: 34rem; }
  .work-card__cta { justify-self: start; margin-top: var(--s-2); }
  .work-card a:hover .work-card__cta { background-size: 100% 1px; background-position: 0 100%; }

  /* Editorial rhythm: wide, narrow-offset, centred, right */
  @media (min-width: 900px) {
    .work-card:nth-child(4n + 1) { grid-column: 1 / span 7; }
    .work-card:nth-child(4n + 2) { grid-column: 9 / -1; margin-top: 38%; }
    .work-card:nth-child(4n + 3) { grid-column: 3 / span 7; }
    .work-card:nth-child(4n + 4) { grid-column: 7 / -1; }
  }
</style>
