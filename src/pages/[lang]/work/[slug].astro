---
import Base from '../../../layouts/Base.astro';
import Media from '../../../components/Media.astro';
import { projects } from '../../../data/site';
import { langs, href, useContent, type Lang, rich } from '../../../i18n';
import { getImage } from 'astro:assets';

export function getStaticPaths() {
  return langs.flatMap((lang) => projects.map((p) => ({ params: { lang, slug: p.slug }, props: { base: p } })));
}

const lang = Astro.params.lang as Lang;
const t = useContent(lang);
const { base } = Astro.props as { base: (typeof projects)[number] };
const p = t.projects[base.slug];
const d = base.design;

// Full-size versions for the lightbox
const large = await Promise.all(base.gallery.map((image) => getImage({ src: image, width: 1800 })));
---
<Base lang={lang} title={`${p.title}, ${p.location.split(',')[0]} | Reframe Studio`} description={p.summary}>
  <article>
    <header class="wrap case-hero">
      <a href={href(lang, '/work/')} class="link link--quiet case-hero__back" data-fade="intro">
        <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="rotate:180deg"><path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.25" /></svg>
        {t.ui.work}
      </a>
      <div class="grid case-hero__grid">
        <h1 class="t-display case-hero__title" data-split="intro">{p.title}</h1>
        <p class="t-lead case-hero__summary" data-fade="intro">{p.summary}</p>
        <dl class="case-hero__meta t-small" data-stagger="intro">
          <div><dt class="t-muted">{t.project.location}</dt><dd>{p.location}</dd></div>
          <div><dt class="t-muted">{t.project.type}</dt><dd>{t.project.typeValue}</dd></div>
          <div><dt class="t-muted">{t.project.published}</dt><dd>{t.project.publishedValue}</dd></div>
          <div><dt class="t-muted">{t.project.updated}</dt><dd>{t.project.updatedValue}</dd></div>
        </dl>
      </div>
    </header>

    <div class="wrap">
      <Media class="case-cover" src={base.cover} alt={t.project.coverAlt(p.title)} ratio="3 / 2" intro morph parallax={0.06} sizes="100vw" />
    </div>

    <section class="wrap section case-gallery">
      <div class="grid">
        {base.gallery.map((image, i) => (
          <figure class="case-gallery__item">
            <button type="button" class="case-gallery__open" data-lightbox={large[i].src} data-alt={`${p.title}: ${p.captions[i]}`} aria-label={`${t.project.enlarge} ${p.captions[i]}`}>
              <Media src={image} alt={`${p.title}: ${p.captions[i]}`} ratio="3 / 2" sizes="(min-width: 900px) 50vw, 100vw" />
            </button>
            <figcaption class="t-small t-muted" data-fade>{p.captions[i]}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Design decisions: on the shared card grid. Type (two thirds) and
         palette (one third), then three decisions you can see in the
         screenshots above, one card each. -->
    <section class="wrap case-design" aria-labelledby="design-title">
      <div class="grid section-head">
        <h2 id="design-title" class="t-h2" data-split set:html={rich(t.project.designTitle)}></h2>
        <p class="t-muted" data-fade>{t.project.designIntro}</p>
      </div>

      <div class="grid cards">
        <div class="card card--raised span-8 case-design__type" data-fade>
          <span class="case-design__pill">{t.project.type}</span>
          <p class:list={['case-design__sample', `case-design__sample--${d.family}`]}>{d.sample}</p>
          <p class="t-muted case-design__note">{p.typeNote}</p>
        </div>
        <div class="card card--raised span-4 case-design__palette" data-fade>
          <span class="case-design__pill">{t.project.palette}</span>
          <ul data-stagger>
            {d.palette.map((hex, i) => (
              <li>
                <span class="case-design__chip" style={`background:${hex}`}></span>
                <span class="case-design__name">{p.paletteNames[i]}</span>
                <span class="case-design__hex">{hex}</span>
              </li>
            ))}
          </ul>
        </div>

        {p.decisions.map((dec) => (
          <div class="card card--raised span-4 case-design__decision" data-fade>
            <span class="case-design__dot" aria-hidden="true"></span>
            <p>{dec}</p>
          </div>
        ))}
      </div>
    </section>
  </article>

  <dialog class="lightbox" data-lightbox-dialog aria-label={t.project.enlarged}>
    <img alt="" />
    <button type="button" class="lightbox__close link" data-lightbox-close>{t.project.close}</button>
  </dialog>
</Base>

<style is:global>
  .case-hero { padding-top: calc(var(--header-h) + var(--s-7)); padding-bottom: var(--s-8); }
  .case-hero__back { margin-bottom: var(--s-8); }
  .case-hero__grid { row-gap: var(--s-7); align-items: end; }
  .case-hero__summary { max-width: 30rem; }
  .case-hero__meta { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-5) var(--gutter); }
  .case-hero__meta dd { margin-top: var(--s-1); }
  @media (min-width: 900px) {
    .case-hero__title { grid-column: 1 / span 8; }
    .case-hero__summary { grid-column: 9 / -1; }
    .case-hero__meta { grid-column: 1 / -1; grid-template-columns: repeat(4, 1fr); }
  }

  .case-cover { view-transition-name: project-hero; }

  .case-gallery .grid { row-gap: var(--s-7); }
  .case-gallery__item { display: grid; gap: var(--s-4); }
  .case-gallery__open { display: block; width: 100%; cursor: zoom-in; }
  .case-gallery__open .media__inner { transition: transform 1.2s var(--ease-out); }
  .case-gallery__open:hover .media__inner { transform: scale(1.03); }
  @media (min-width: 900px) {
    .case-gallery__item:nth-child(1) { grid-column: 1 / span 8; }
    .case-gallery__item:nth-child(2) { grid-column: 9 / -1; margin-top: 30%; }
  }

  .case-design { padding-bottom: var(--s-section); }
  .case-design .cards { row-gap: var(--gutter); }
  .case-design__pill {
    justify-self: start; padding: .35rem .8rem; border-radius: var(--radius-pill);
    font-size: var(--fs-label); font-weight: var(--fw-medium);
    background: rgb(255 255 255 / .06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .08);
  }
  .case-design__type { gap: var(--s-6); align-content: space-between; min-height: clamp(18rem, 14rem + 10vw, 26rem); }
  .case-design__sample { font-size: clamp(3rem, 1.8rem + 4.6vw, 7rem); line-height: .95; color: var(--c-ink); }
  .case-design__sample--serif { font-family: var(--font-serif); letter-spacing: -.01em; }
  .case-design__sample--sans { font-family: var(--font-display); font-weight: 600; letter-spacing: -.03em; }
  .case-design__note { max-width: 34rem; }
  .case-design__palette { gap: var(--s-5); align-content: start; }
  .case-design__palette ul { display: grid; gap: var(--s-3); }
  .case-design__palette li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-3); }
  .case-design__chip { width: 2.25rem; aspect-ratio: 1; border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .12); }
  .case-design__name { font-weight: var(--fw-medium); }
  .case-design__hex { font-size: var(--fs-label); color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  .case-design__decision { gap: var(--s-5); align-content: start; font-size: var(--fs-lead); line-height: 1.4; }
  .case-design__dot { width: .625rem; height: .625rem; border-radius: 50%; background: var(--accent); }

  .lightbox {
    margin: auto; padding: 0; border: 0; background: transparent;
    max-width: 92vw; max-height: 92svh; overflow: visible;
    opacity: 0; scale: .97;
    transition: opacity var(--d-base) var(--ease-soft), scale var(--d-base) var(--ease-out), overlay var(--d-base) allow-discrete, display var(--d-base) allow-discrete;
  }
  .lightbox[open] { opacity: 1; scale: 1; }
  @starting-style { .lightbox[open] { opacity: 0; scale: .97; } }
  .lightbox::backdrop { background: rgb(11 11 11 / 0); transition: background var(--d-base) var(--ease-soft), overlay var(--d-base) allow-discrete, display var(--d-base) allow-discrete; }
  .lightbox[open]::backdrop { background: rgb(11 11 11 / .9); }
  @starting-style { .lightbox[open]::backdrop { background: rgb(11 11 11 / 0); } }
  .lightbox img { max-width: 92vw; max-height: 86svh; width: auto; height: auto; }
  .lightbox__close { position: absolute; top: calc(100% + var(--s-3)); right: 0; color: var(--c-ink); }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const img = dialog?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!dialog || !img) return;
      img.src = b.dataset.lightbox!;
      img.alt = b.dataset.alt ?? '';
      dialog.showModal();
      window.lenis?.stop();
    }),
  );
  dialog?.addEventListener('close', () => window.lenis?.start());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
</script>
