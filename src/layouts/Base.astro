---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { langs, defaultLang, swapLang, useContent, type Lang } from '../i18n';
import { site, img } from '../data/site';
import { getImage } from 'astro:assets';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  closing?: boolean;   // show the shared CTA + footer block
  alternates?: boolean; // emit hreflang links (off for pages that exist in one language)
  noindex?: boolean;    // keep the page out of search results (404, redirects)
}
const { lang, title, description, closing = true, alternates = true, noindex = false } = Astro.props;
const t = useContent(lang);
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
// Share image for social networks and messaging apps: the hero interior, cropped to 1200 × 630
const og = await getImage({ src: img.hero, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(swapLang(path, l), Astro.site)} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(swapLang(path, defaultLang), Astro.site)} />}
    <meta property="og:locale" content={{ en: 'en_GB', es: 'es_ES', fr: 'fr_FR' }[lang]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Reframe Studio" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600&f[]=satoshi@400,500,700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />

    <!-- Runs before first paint: sets motion state and catches page-transition info -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.classList.add('js');
        if (reduce) d.classList.add('motion-off');
        if (sessionStorage.getItem('reframe:morph')) {
          d.classList.add('morph-in');
          sessionStorage.removeItem('reframe:morph');
        }
        window.__reveal = new Promise(function (resolve) {
          addEventListener('pagereveal', function (e) { resolve(!!e.viewTransition); }, { once: true });
          setTimeout(function () { resolve(false); }, 250);
        });
        // Never leave content hidden if scripts fail
        setTimeout(function () {
          if (!d.classList.contains('motion-ready')) d.classList.add('motion-off');
        }, 3500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    {closing && <Footer lang={lang} />}
    <CookieBanner lang={lang} />

    <div class="grid-overlay" aria-hidden="true">
      <div class="wrap grid">{Array.from({ length: 12 }).map(() => <span />)}</div>
    </div>

    <script>
      import '../scripts/motion';
    </script>

    <!-- Analytics: only with consent ("Accept all") and only if a GA4 ID is configured in data/site.ts -->
    <script is:inline define:vars={{ GA: site.analytics.ga4 }}>
      (function () {
        if (!GA) return;
        var loaded = false;
        function load() {
          if (loaded) return; loaded = true;
          var s = document.createElement('script');
          s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', GA, { anonymize_ip: true });
        }
        if (localStorage.getItem('reframe:cookies') === 'all') load();
        addEventListener('reframe:consent', function (e) { if (e.detail === 'all') load(); });
      })();
    </script>
  </body>
</html>
